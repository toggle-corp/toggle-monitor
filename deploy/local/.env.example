# Copy to deploy/local/.env (which is .gitignored) and fill in real
# secrets to exercise Slack output locally. The defaults below let the
# stack boot but Slack posts will fail (auth.test fails → cached
# warning state; everything else still works).

DB_PASSWORD=toggle-monitor-dev
SLACK_BOT_TOKEN=xoxb-replace-me

# Optional: absolute path to a host-side kubeconfig file. When set,
# docker-compose mounts it read-only into the app container at the
# same path and exports KUBECONFIG so the auto-discovery code points
# at it. Leave empty (or commented out) to disable auto-discovery
# entirely.
#
# IMPORTANT — context reachability from inside the container:
#   - Docker Desktop:  use `host.docker.internal` for the cluster API.
#   - Linux + kind:    the kind control-plane container is on the host
#                       docker network; copy ~/.kube/config and rewrite
#                       the server URL to the kind node IP, OR run
#                       toggle-monitor on the host (not in compose).
# A kubeconfig pointing at 127.0.0.1 from inside the container will
# fail to connect — that's the loopback of the container, not the host.
#
# KUBECONFIG_HOST=/home/you/.kube/config
