package templates

import (
	"fmt"
	"net/url"
	"regexp"
	"strings"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// StatusConfig is the display-side mirror of one config.StatusPage —
// what /status/<slug> needs to render. Lifecycle builds one of these
// per configured page at startup; the page handler reads it on every
// request. The match predicates are mirrored as StatusMatch with the
// hostRegex pre-compiled so per-request matching skips
// regexp.Compile. See ADR-0003.
type StatusConfig struct {
	Slug         string
	FriendlyName string
	Description  string
	LogoURL      string
	Color        string // ^#[0-9a-fA-F]{6}$ or empty
	Sections     []StatusConfigSection
}

// StatusConfigSection is one named block on a status page — a title
// and a predicate evaluated against each monitor.
type StatusConfigSection struct {
	Title string
	Match StatusMatch
}

// StatusMatch is the templates-side mirror of config.SectionMatch. A
// node is either a leaf (Tags AND HostRegex) or a branch (Any / All).
// HostRegex is pre-compiled by lifecycle.
type StatusMatch struct {
	Tags      []string
	HostRegex *regexp.Regexp
	Any       []StatusMatch
	All       []StatusMatch
}

// Matches reports whether a monitor's tag set and host satisfy the
// predicate. The caller is responsible for building the tag set once
// per monitor (StatusTagSet).
func (m StatusMatch) Matches(tagSet map[string]bool, host string) bool {
	if len(m.Any) > 0 {
		for _, c := range m.Any {
			if c.Matches(tagSet, host) {
				return true
			}
		}
		return false
	}
	if len(m.All) > 0 {
		for _, c := range m.All {
			if !c.Matches(tagSet, host) {
				return false
			}
		}
		return true
	}
	// Leaf. Empty leaves are filtered out at config-validation time.
	if len(m.Tags) == 0 && m.HostRegex == nil {
		return false
	}
	for _, t := range m.Tags {
		if !tagSet[t] {
			return false
		}
	}
	if m.HostRegex != nil && !m.HostRegex.MatchString(host) {
		return false
	}
	return true
}

// StatusTagSet builds a presence map from a slice of tags.
func StatusTagSet(tags []string) map[string]bool {
	set := make(map[string]bool, len(tags))
	for _, t := range tags {
		set[t] = true
	}
	return set
}

// StatusSection is one rendered block on a status page detail view —
// title + the monitors that landed in it. Sections returns them in
// declared (config) order; monitors within a section keep the input
// order (typically ListActiveMonitors's down → paused → up-then-name)
// so failures sit at the top.
type StatusSection struct {
	Title    string
	Monitors []store.MonitorRow
}

// BuildStatusSections groups the active-monitors set into sections by
// applying each section's predicate. A monitor lands in a section
// when its tag set and host satisfy the section's match. A monitor
// can appear in multiple sections (N:M) — the status page is a
// curated view, not a strict partition.
func BuildStatusSections(cfg *StatusConfig, monitors []store.MonitorRow) []StatusSection {
	if cfg == nil {
		return nil
	}
	out := make([]StatusSection, 0, len(cfg.Sections))
	// Precompute each monitor's (tagSet, host) once.
	type prepared struct {
		row store.MonitorRow
		set map[string]bool
		host string
	}
	prep := make([]prepared, len(monitors))
	for i, m := range monitors {
		prep[i] = prepared{
			row:  m,
			set:  StatusTagSet(m.Tags),
			host: hostFromURL(m.URL),
		}
	}
	for _, sec := range cfg.Sections {
		bucket := StatusSection{Title: sec.Title}
		for _, p := range prep {
			if sec.Match.Matches(p.set, p.host) {
				bucket.Monitors = append(bucket.Monitors, p.row)
			}
		}
		out = append(out, bucket)
	}
	return out
}

// PageMatches reports whether at least one section on cfg selects a
// given monitor. Used by the homepage tile builder and by the
// monitor-detail "Appears on" backlinks.
func (c *StatusConfig) PageMatches(tagSet map[string]bool, host string) bool {
	if c == nil {
		return false
	}
	for _, sec := range c.Sections {
		if sec.Match.Matches(tagSet, host) {
			return true
		}
	}
	return false
}

func hostFromURL(s string) string {
	u, err := url.Parse(s)
	if err != nil {
		return ""
	}
	return u.Host
}

// rootURL returns the scheme+host portion of a URL — the application
// "open this app" link, distinct from the full health-check URL the
// monitor probes. Empty when the URL can't be parsed or lacks a host.
func rootURL(s string) string {
	u, err := url.Parse(s)
	if err != nil || u.Host == "" || u.Scheme == "" {
		return ""
	}
	return u.Scheme + "://" + u.Host
}

// statusBadgeKind picks the page-level 3-state badge:
//   - "none"  → no monitors selected on this page
//   - "down"  → any monitor down
//   - "warn"  → any monitor paused / ssl-expiring
//   - "up"    → everything operational
//
// ssl-skipped is intentional configuration (HTTP-only static monitors,
// or tlsInsecureSkipVerify) and never degrades the badge.
func statusBadgeKind(sections []StatusSection) string {
	var total, anyDown, anyWarn int
	for _, sec := range sections {
		total += len(sec.Monitors)
		for _, m := range sec.Monitors {
			switch string(m.Status) {
			case "down":
				anyDown++
			case "temporary-paused":
				anyWarn++
			}
			if m.SSLStatus != nil && string(*m.SSLStatus) == "ssl-expiring" {
				anyWarn++
			}
		}
	}
	switch {
	case total == 0:
		return "none"
	case anyDown > 0:
		return "down"
	case anyWarn > 0:
		return "warn"
	default:
		return "up"
	}
}

func statusBadgeLabel(kind string) string {
	switch kind {
	case "down":
		return "Down"
	case "warn":
		return "Degraded"
	case "none":
		return "No monitors"
	default:
		return "Operational"
	}
}

// statusSectionCols is the column template for a status page's
// per-section table: the monitor and its URLs take the width, SSL and
// status sit at their natural size.
const statusSectionCols = "2fr .8fr .9fr"

// pageTitle returns the configured FriendlyName or a sensible default.
func pageTitle(cfg *StatusConfig) string {
	if cfg == nil || strings.TrimSpace(cfg.FriendlyName) == "" {
		return "Status"
	}
	return cfg.FriendlyName
}

// StatusPage renders the per-page detail view at /status/<slug>.
// Rendered inside the standard operator layout (nav + theme toggle).
// cfg == nil means no statusPages were configured — the page renders
// an empty placeholder rather than 404ing so a bookmark still
// resolves to something explanatory.
templ StatusPage(cfg *StatusConfig, sections []StatusSection, stats StatusPageStats) {
	@Layout(pageTitle(cfg)) {
		if cfg == nil {
			@EmptyState("No status pages configured") {
				Add a <span class="text-ink">statusPages:</span> block to config.yaml to populate this page.
			}
		} else {
			{{ kind := statusBadgeKind(sections) }}
			<header class="bg-surface border border-border border-t-[3px] border-t-accent rounded-lg px-7 py-[26px] flex items-center gap-3.5">
				if cfg.LogoURL != "" {
					<img src={ cfg.LogoURL } alt="" class="w-[46px] h-[46px] rounded-md object-contain shrink-0"/>
				} else {
					@Avatar(firstInitial(pageTitle(cfg)), avatarColor(cfg.Color), 46)
				}
				<div class="min-w-0">
					<div class="flex flex-wrap items-center gap-2.5">
						<h1 class="m-0 text-[22px] font-extrabold text-ink tracking-[-.01em]">{ pageTitle(cfg) }</h1>
						<span class="font-mono text-2xs text-faint border border-border rounded-md px-[7px] py-px">/status/{ cfg.Slug }</span>
					</div>
					if cfg.Description != "" {
						<p class="text-[13px] text-muted mt-1">{ cfg.Description }</p>
					}
				</div>
				<span class="ml-auto shrink-0">
					@Badge(statusTone(kind), statusBadgeLabel(kind))
				</span>
			</header>
			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
				@MetricTileLink(ToneNeutral, "total", stats.Total, statusListingURL(cfg.Slug, -1, ""), false)
				@MetricTileLink(ToneUp, "up", stats.Up, statusListingURL(cfg.Slug, -1, "up"), true)
				@MetricTileLink(ToneDown, "down", stats.Down, statusListingURL(cfg.Slug, -1, "down"), false)
				@MetricTileLink(TonePaused, "paused", stats.TemporaryPaused, statusListingURL(cfg.Slug, -1, "temporary-paused"), false)
				@MetricTileLink(ToneWarn, "ssl exp", stats.SSLExpiring, statusListingURL(cfg.Slug, -1, "ssl-expiring"), false)
				@MetricTileLink(ToneDown, "expired", stats.SSLExpired, statusListingURL(cfg.Slug, -1, "expired"), false)
			</div>
			for idx, sec := range sections {
				<section class="flex flex-col gap-2.5">
					<a href={ templ.SafeURL(sectionListingURL(cfg.Slug, idx)) } class="w-fit rounded-sm hover:underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
						@SectionHeader(sec.Title, monitorCountLabel(len(sec.Monitors)))
					</a>
					if len(sec.Monitors) == 0 {
						@EmptyState("No monitors in this section") {
							Nothing on this status page matches this section's selectors.
						}
					} else {
						@Table(statusSectionCols) {
							@TableRow(true, "") {
								@TableHeadCell("") {
									monitor
								}
								@TableHeadCell("") {
									ssl
								}
								@TableHeadCell("") {
									status
								}
							}
							for _, m := range sec.Monitors {
								@statusMonitorRow(m)
							}
						}
					}
				</section>
			}
			<p class="font-mono text-2xs text-dim text-center">powered by toggle-monitor</p>
		}
	}
}

// statusMonitorRow is one monitor on a status page: its name over the
// two URLs it implies, then SSL and live status.
templ statusMonitorRow(m store.MonitorRow) {
	@TableRow(false, MonitorTone(string(m.Status), m.Archived)) {
		@TableCell("") {
			<div class="flex flex-col gap-0.5 min-w-0">
				<a href={ templ.SafeURL("/monitor/" + m.Slug) } class="w-fit text-[13px] hover:underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
					@MonitorName(m.FriendlyName)
				</a>
				@MonitorURLCell(m.URL)
			</div>
		}
		@TableCell("") {
			{{ var sslStatus string }}
			if m.SSLStatus != nil {
				{{ sslStatus = string(*m.SSLStatus) }}
			}
			@SSLCell(sslStatus, m.SSLExpiresAt)
		}
		@TableCell("") {
			if m.Archived {
				@ArchivedChip()
			} else {
				@StatusBadge(string(m.Status))
			}
		}
	}
}

// monitorCountLabel is the dim meta beside a section heading.
func monitorCountLabel(n int) string {
	if n == 1 {
		return "1 monitor →"
	}
	return fmt.Sprintf("%d monitors →", n)
}

// sectionListingURL is the operator drill-down URL for a specific
// section on /monitors. ?status_page=<slug>&section=<idx>.
func sectionListingURL(slug string, idx int) string {
	return "/monitors?status_page=" + slug + "&section=" + sectionIndexString(idx)
}

// statusListingURL builds a /monitors filter URL scoped to a status
// page (optionally a specific section) with an extra status/ssl
// filter applied. sectionIdx < 0 means "any section in the page".
// kind is one of "" / "up" / "down" / "temporary-paused" /
// "ssl-expiring" / "ssl-skipped". SSL kinds set ?ssl=; the rest set
// ?status=. Empty kind drops the extra filter entirely.
func statusListingURL(slug string, sectionIdx int, kind string) string {
	q := "/monitors?status_page=" + slug
	if sectionIdx >= 0 {
		q += "&section=" + sectionIndexString(sectionIdx)
	}
	switch kind {
	case "":
		// no extra filter
	case "ssl-expiring", "ssl-skipped", "ok", "expired":
		q += "&ssl=" + kind
	default:
		q += "&status=" + kind
	}
	return q
}

func sectionIndexString(idx int) string {
	// Avoid bringing in strconv for a single use; inline.
	if idx == 0 {
		return "0"
	}
	var b strings.Builder
	n := idx
	if n < 0 {
		b.WriteByte('-')
		n = -n
	}
	var digits [20]byte
	i := len(digits)
	for n > 0 {
		i--
		digits[i] = byte('0' + n%10)
		n /= 10
	}
	b.Write(digits[i:])
	return b.String()
}

// StatusIndexPage renders /status — alphabetical by FriendlyName.
// Each entry is a card carrying the page's branding (logo + color +
// description) plus a status badge and an at-a-glance count row.
// Sorting + stats computation are done by the caller (web layer) so
// this template can stay pure.
templ StatusIndexPage(entries []StatusPageStats) {
	@Layout("Status pages") {
		<div class="flex items-baseline gap-2.5">
			@PageTitle(false) {
				Status pages
			}
			<span class="font-mono text-xs text-faint">{ pageCountLabel(len(entries)) }</span>
		</div>
		if len(entries) == 0 {
			@EmptyState("No status pages configured") {
				Add a <span class="text-ink">statusPages:</span> block to config.yaml to populate this view.
			}
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				for _, e := range entries {
					@statusPageTile(e)
				}
			</div>
		}
	}
}

// pageCountLabel is the dim meta beside the /status heading.
func pageCountLabel(n int) string {
	return fmt.Sprintf("%d configured", n)
}
