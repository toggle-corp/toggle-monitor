package templates

import (
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/config"
	"github.com/toggle-corp/toggle-monitor/internal/merger"
	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// DiscoveryStatus is what handleDiscoveryListing passes alongside the
// rows so the empty state can explain *why* the page is empty:
// auto-discovery off entirely vs. configured-but-no-ingresses-yet.
type DiscoveryStatus struct {
	KubeEnabled    bool          // cfg.Kube != nil
	ResyncInterval time.Duration // 0 when disabled
	WatchDebounce  time.Duration // 0 when watch-driven reconciles are off
}

// DiscoveryFilter is the slim shape the listing handler passes to the
// template for repopulating the filter form. Empty fields = "any".
type DiscoveryFilter struct {
	Namespace string // glob-matched against the row's namespace
	Status    string // exact match: added | kube-paused | kube-invalid | kube-ignored
}

// discoveryCols is the snapshot listing's column template: namespace,
// ingress, host, status, reason, materialized monitor.
const discoveryCols = ".9fr 1.1fr 1.4fr .9fr 1.6fr 1.1fr"

templ DiscoveryListing(rows []store.DiscoverySnapshotRow, filter DiscoveryFilter, status DiscoveryStatus) {
	@Layout("Auto-discovery") {
		@Eyebrow("Auto-discovery snapshot · " + summary(rows))
		if status.KubeEnabled {
			<form
				hx-get="/discovery"
				hx-target="body"
				hx-push-url="true"
				method="get"
				action="/discovery"
			>
				@Toolbar() {
					<div class="flex-1 min-w-[200px]">
						@SearchField("ns", "namespace — exact or glob (e.g. test-*)", filter.Namespace)
					</div>
					@SelectField("status", "Status") {
						<option value="" selected?={ filter.Status == "" }>status: any</option>
						<option value="added" selected?={ filter.Status == "added" }>added</option>
						<option value="kube-paused" selected?={ filter.Status == "kube-paused" }>kube-paused</option>
						<option value="kube-invalid" selected?={ filter.Status == "kube-invalid" }>kube-invalid</option>
						<option value="kube-ignored" selected?={ filter.Status == "kube-ignored" }>kube-ignored</option>
					}
					@Button("primary", "submit") {
						apply
					}
					if filter.Namespace != "" || filter.Status != "" {
						@LinkButton("ghost", "/discovery") {
							clear
						}
					}
				}
			</form>
		}
		if len(rows) == 0 {
			if filter.Namespace != "" || filter.Status != "" {
				@EmptyState("No discovery rows match the current filters") {
					<a class="text-accent underline underline-offset-2 hover:text-accent-strong rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/discovery">clear filters</a>
				}
			} else {
				@discoveryEmptyState(status)
			}
		} else {
			<div class="overflow-x-auto">
				@Table(discoveryCols) {
					@TableRow(true, "") {
						@TableHeadCell("") {
							namespace
						}
						@TableHeadCell("") {
							ingress
						}
						@TableHeadCell("") {
							host
						}
						@TableHeadCell("") {
							status
						}
						@TableHeadCell("") {
							reason
						}
						@TableHeadCell("") {
							monitor
						}
					}
					for _, r := range rows {
						@discoveryRow(r)
					}
				}
			</div>
		}
	}
}

// discoveryRow is one snapshot row. The ingress name links to the
// cascade trace, which is where an operator goes to answer "why did
// this end up in that state?".
templ discoveryRow(r store.DiscoverySnapshotRow) {
	@TableRow(false, discoveryRowTone(r.Status)) {
		@TableCell("") {
			<span class="text-muted break-all">{ r.Namespace }</span>
		}
		@TableCell("") {
			<a class="text-accent hover:text-accent-strong hover:underline underline-offset-2 break-all rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/discovery/" + r.Namespace + "/" + r.IngressName + "/" + r.Host) }>{ r.IngressName }</a>
		}
		@TableCell("") {
			<span class="break-all">{ r.Host }</span>
		}
		@TableCell("") {
			@DiscoveryBadge(r.Status)
		}
		@TableCell("") {
			if r.Reason != nil && *r.Reason != "" {
				<span class="text-muted break-words">{ *r.Reason }</span>
			} else {
				@Dash()
			}
		}
		@TableCell("") {
			if r.MonitorSlug != nil {
				<a class="text-accent hover:text-accent-strong hover:underline underline-offset-2 break-all rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/monitor/" + *r.MonitorSlug) }>{ *r.MonitorSlug }</a>
			} else {
				@Dash()
			}
		}
	}
}

// discoveryEmptyState picks one of three messages: kube block absent,
// kube enabled but reconcile pending, or kube enabled + nothing to
// see (real cluster, zero ingresses). The "pending" vs. "nothing"
// distinction is heuristic — there's no startup timestamp here, so we
// lean on the reconcile triggers to phrase the wait honestly: a new
// Ingress lands one watchDebounce after its watch event, and
// resyncInterval is the ceiling when watch-driven reconciles are off.
templ discoveryEmptyState(s DiscoveryStatus) {
	if !s.KubeEnabled {
		@EmptyState("Auto-discovery is disabled") {
			The <span class="text-ink">kube</span> block is not set in <span class="text-ink">config.yaml</span>. Add one to start watching cluster ingresses — see <span class="text-ink">docs/config-example.yaml</span>.
		}
	} else {
		@EmptyState("Auto-discovery is enabled — no ingresses observed yet") {
			if s.WatchDebounce > 0 {
				The watcher picks up a new Ingress about { humanInterval(s.WatchDebounce) } after it appears, and re-reconciles every { humanInterval(s.ResyncInterval) } regardless.
			} else {
				The watcher reconciles every { humanInterval(s.ResyncInterval) }.
			}
			If your cluster has Ingress resources and this stays empty, check the app logs for <span class="text-ink">kube reconcile failed</span> or RBAC errors on <span class="text-ink">networking.k8s.io/ingresses</span>.
		}
	}
}

templ DiscoveryDetail(view DiscoveryDetailView) {
	{{ row := view.Row }}
	@Layout("Discovery — "+row.IngressName) {
		@Breadcrumb([]Crumb{{Label: "Discovery", Href: "/discovery"}, {Label: row.Namespace + "/" + row.IngressName}})
		<div class="flex flex-wrap items-center gap-3.5">
			@PageTitle(true) {
				@MonitorID(row.Namespace, row.IngressName)
			}
			@DiscoveryBadge(row.Status)
			<span class="font-mono text-xs text-muted">{ row.Host }</span>
		</div>
		@List("Snapshot", false) {
			@KeyValue("status", kvKeyWidth) {
				@DiscoveryBadge(row.Status)
			}
			if row.Reason != nil {
				@kv("reason", *row.Reason)
			}
			if row.MonitorSlug != nil {
				@KeyValue("materialized monitor", kvKeyWidth) {
					<a class="text-accent hover:text-accent-strong underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/monitor/" + *row.MonitorSlug) }>{ *row.MonitorSlug }</a>
				}
			}
		}
		@annotationSources(view)
		@cascadeSection(view)
	}
}

// annotationSources renders the ADR-0009 inputs: which fields an
// annotation supplied, and which annotation values were rejected.
// Rendered above the cascade because it answers the question the
// cascade alone cannot — the tree shows a value landing at a rule, not
// that the value came from outside reviewed config. Suppressed
// entirely for a literals-only cascade.
templ annotationSources(view DiscoveryDetailView) {
	if len(view.Provenance) > 0 || len(view.Warnings) > 0 {
		<section class="flex flex-col gap-3">
			@SectionHeader("Annotation sources", "")
			if len(view.Provenance) > 0 {
				@List("", false) {
					for _, p := range view.Provenance {
						<div class="flex flex-wrap gap-2 items-baseline py-[9px] font-mono text-xs">
							<span class="text-ink">{ p.Field }</span>
							<span class="text-muted">{ p.Value }</span>
							<span class="text-dim" aria-hidden="true">←</span>
							<span class="text-faint">{ p.Scope }</span>
							@Chip(ToneNeutral) {
								{ p.Key }
							}
							<span class="ml-auto text-dim">{ p.Rule }</span>
						</div>
					}
				}
			}
			if len(view.Warnings) > 0 {
				@Banner(ToneWarn) {
					<span class="text-ink font-semibold">Rejected annotation values.</span>
					<span> The monitor still probes on its cascade value. Fix the annotation to make it take effect.</span>
				}
				@List("", false) {
					for _, w := range view.Warnings {
						<div class="flex flex-wrap gap-2 items-baseline py-[9px] font-mono text-xs">
							<span class="text-ink">{ w.Field }</span>
							<span class="text-faint">{ w.Scope }</span>
							@Chip(ToneNeutral) {
								{ w.Key }
							}
							<span class="text-warn font-semibold">{ w.Value }</span>
							<span class="text-muted">{ w.Reason }</span>
							<span class="ml-auto text-dim">{ w.Rule }</span>
						</div>
					}
				}
			}
		</section>
	}
}

// cascadeSection branches on view.Outcome to render the right body
// for the live cascade trace. The outcomes were locked in the
// /grill-me design discussion: disabled / stale / no-match get
// banners only, materialized / ignored / invalid render the per-rule
// diff cascade plus a resolved block tailored to the outcome.
templ cascadeSection(view DiscoveryDetailView) {
	switch view.Outcome {
		case DiscoveryOutcomeDisabled:
			@cascadeBannerDisabled()
		case DiscoveryOutcomeStale:
			@cascadeBannerStale()
		case DiscoveryOutcomeNoMatch:
			@cascadeBannerNoMatch()
		case DiscoveryOutcomeIgnored:
			@cascadeBannerIgnored(view)
			@cascadeRules(view.Trace, view.InvalidField)
			@cascadeResolvedWouldHaveBeen(view.Resolved)
		case DiscoveryOutcomeInvalid:
			@cascadeBannerInvalid(view)
			@cascadeRules(view.Trace, view.InvalidField)
			@cascadeResolved(view.Resolved, view.InvalidField, view.Slug)
		case DiscoveryOutcomeMaterialized:
			@SectionHeader("Match cascade", "")
			@cascadeRules(view.Trace, "")
			@cascadeResolved(view.Resolved, "", view.Slug)
	}
}

// cascadeBannerDisabled — kube auto-discovery is off entirely, so
// there's no in-memory match tree to walk. Operators land here
// usually via a stale link; they need a pointer back to /discovery.
templ cascadeBannerDisabled() {
	@EmptyState("Cascade unavailable — kube auto-discovery is disabled") {
		Add a <span class="text-ink">kube:</span> block to <span class="text-ink">config.yaml</span> to enable the live cascade view.
	}
}

// cascadeBannerStale — the snapshot row exists but the ingress is
// no longer in the informer cache (deleted, RBAC, or never observed).
// Per the design grilling: hard 410-style banner with no
// reconstructed cascade.
templ cascadeBannerStale() {
	@Banner(ToneWarn) {
		<span class="text-ink font-semibold">Cascade unavailable — ingress no longer present in cluster.</span>
		<span> The snapshot above is the last persisted result. To see the live cascade again, re-create the Ingress or wait for the next reconcile to pick it up.</span>
	}
}

// cascadeBannerNoMatch — should be unreachable in production (the
// validator requires a root rule with empty when:), but operator
// configs do change and we want a graceful message rather than a
// confusing blank section.
templ cascadeBannerNoMatch() {
	@EmptyState("No kube.match rule matched this ingress/host") {
		Production configs require a root rule with an empty <span class="text-ink">when:</span>. Check <span class="text-ink">config.yaml</span> — the root rule may be missing or have an unintended selector.
	}
}

// cascadeBannerIgnored highlights which rule flipped ignore so the
// operator immediately knows what to look at when debugging "why isn't
// this ingress being monitored?". A wildcard host gets a second line:
// the resolved block below reads as "would have materialized as…",
// which is not true for a host no prober can resolve (ADR-0012).
templ cascadeBannerIgnored(view DiscoveryDetailView) {
	@Banner(ToneWarn) {
		<span class="text-ink font-semibold">This ingress is ignored — no monitor was materialized.</span>
		<span> A rule below set <span class="text-ink">ignore: true</span>. The cascade is still shown so you can see which rule made the call.</span>
		if view.WildcardHost {
			<span> This host is a wildcard, so no monitor was possible here regardless of the rule — <span class="text-ink">https://{ view.Row.Host }/</span> never resolves.</span>
		}
	}
	@SectionHeader("Match cascade", "")
}

// cascadeBannerInvalid surfaces the materialization blocker — a
// resolved-validation error from merger.checkResolved, or a wildcard
// host (ADR-0012), which is a property of the host rather than of any
// resolved value. The rule trace is still rendered so the operator can
// see which rule wrote the field that triggered a validation failure.
templ cascadeBannerInvalid(view DiscoveryDetailView) {
	@Banner(ToneDown) {
		if view.WildcardHost {
			<span class="text-ink font-semibold">Host is not probeable — daemon emitted <span class="text-down">kube-invalid</span>.</span>
			<span> Acknowledge it with a matching <span class="text-ink">ignore: true</span> rule to record it as <span class="text-ink">kube-ignored</span> instead.</span>
		} else {
			<span class="text-ink font-semibold">Resolved config is invalid — daemon emitted <span class="text-down">kube-invalid</span>.</span>
		}
		<span class="block mt-1 break-words">{ view.InvalidError }</span>
	}
	@SectionHeader("Match cascade", "")
}

// cascadeRules renders one card per matched rule. invalidField is
// passed through so each event card can highlight a row whose key
// matches the offending field.
templ cascadeRules(traces []merger.RuleTrace, invalidField string) {
	<div class="flex flex-col gap-3">
		for _, rt := range traces {
			@cascadeRuleCard(rt, invalidField)
		}
	</div>
}

// cascadeRuleCard is one matched rule's contribution. Header carries
// the rule label + selector summary + final flag; body lists the
// per-key events.
templ cascadeRuleCard(rt merger.RuleTrace, invalidField string) {
	<section class="border border-border rounded-lg overflow-hidden bg-bg">
		<header class="flex items-center gap-2 px-4 py-2 border-b border-border bg-surface-muted font-mono text-xs">
			<span class="text-ink">{ rt.Label }</span>
			if rt.When != " ()" {
				<span class="text-faint">{ rt.When }</span>
			}
			if rt.Final {
				<span class="ml-auto">
					@Chip(ToneDown) {
						final
					}
				</span>
			}
		</header>
		if len(rt.Events) == 0 {
			<div class="px-4 py-2 font-mono text-2xs text-faint">no config writes — selector match only</div>
		} else {
			<div class="px-4 [&>*]:border-t [&>*]:border-hair [&>*:first-child]:border-t-0">
				for _, ev := range rt.Events {
					@traceEventRow(ev, invalidField)
				}
			</div>
		}
	</section>
}

// traceEventRow renders one (rule, key) write in the shared key-value
// shape, so operators read these the same way they read the monitor
// detail page. The row whose key failed validation carries the down
// wash, extended to the section's edges so the highlight reads as a
// band rather than a floating box.
templ traceEventRow(ev merger.TraceEvent, invalidField string) {
	<div class={ "flex py-[9px] font-mono text-xs gap-2", templ.KV("bg-down-soft -mx-4 px-4", ev.Key == invalidField) }>
		<span style={ "width:" + px(kvWideKeyWidth) } class="flex-none flex flex-wrap items-center gap-x-2 gap-y-1 text-faint">
			<span class="break-all">{ ev.Key }</span>
			<span class={ "inline-block text-2xs px-1.5 rounded", TraceActionClass(ev.Action) }>{ string(ev.Action) }</span>
		</span>
		<span class="text-ink min-w-0 break-words">
			@traceEventValue(ev)
		</span>
	</div>
}

// traceEventValue picks the right "what changed" rendering for the
// action. Scalars get "old → new" or just "new" for the first write.
// Union-add highlights only the elements this layer added; override
// shows the discarded prior alongside the new accumulator.
templ traceEventValue(ev merger.TraceEvent) {
	switch ev.Action {
		case merger.TraceSet:
			if len(ev.NewList) > 0 {
				{ FormatTraceList(ev.NewList) }
			} else {
				{ ev.NewValue }
			}
		case merger.TraceReplace:
			if len(ev.NewList) > 0 || len(ev.OldList) > 0 {
				<span class="line-through text-dim">{ FormatTraceList(ev.OldList) }</span>
				<span class="px-1 text-dim" aria-hidden="true">→</span>
				{ FormatTraceList(ev.NewList) }
			} else {
				<span class="line-through text-dim">{ ev.OldValue }</span>
				<span class="px-1 text-dim" aria-hidden="true">→</span>
				{ ev.NewValue }
			}
		case merger.TraceAdd:
			for i, v := range ev.Added {
				if i > 0 {
					<span class="text-dim">, </span>
				}
				<span class="text-up">+ </span>
				{ v }
			}
			<span class="text-dim text-2xs ml-2">(now { FormatTraceList(ev.NewList) })</span>
		case merger.TraceOverride:
			<span class="line-through text-dim">{ FormatTraceList(ev.OldList) }</span>
			<span class="px-1 text-dim" aria-hidden="true">→</span>
			{ FormatTraceList(ev.NewList) }
			<span class="text-down text-2xs ml-2">!override</span>
	}
}

// cascadeResolved renders the final resolved KubeConfig using the same
// key-value rows as the monitor detail page. When invalidField is
// non-empty, the row for that key carries the down wash so the
// operator's eye lands on the failing field. Slug, when non-empty,
// links to the materialized monitor.
templ cascadeResolved(resolved *config.KubeConfig, invalidField, slug string) {
	if resolved != nil {
		@List("Resolved", false) {
			if slug != "" {
				@KeyValue("monitor slug", kvWideKeyWidth) {
					<a class="text-accent hover:text-accent-strong underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/monitor/" + slug) }>{ slug }</a>
				}
			}
			@resolvedRows(resolved, invalidField)
		}
	}
}

// cascadeResolvedWouldHaveBeen wraps the Resolved card in a
// collapsible <details> with a "Would have materialized as" caption,
// matching the locked design for the ignored outcome.
templ cascadeResolvedWouldHaveBeen(resolved *config.KubeConfig) {
	if resolved != nil {
		<details class="border border-border rounded-lg overflow-hidden bg-bg">
			<summary class="cursor-pointer select-none px-[14px] py-[9px] font-mono text-2xs tracking-[.06em] uppercase text-faint hover:text-ink">
				Would have materialized as… <span class="text-dim">(click to expand)</span>
			</summary>
			<div class="px-4 border-t border-border [&>*]:border-t [&>*]:border-hair [&>*:first-child]:border-t-0">
				@resolvedRows(resolved, "")
			</div>
		</details>
	}
}

// resolvedRows mirrors the layout + helpers used by configDialog on
// the monitor detail page so the Resolved card and the "Show config"
// dialog read identically. Each scalar runs through the same helper
// (humanInterval, boolYesNo) the monitor detail page uses; HTTP
// codes go through @kvHTTPCodes for the toned chip treatment; tags go
// through @kvTags. The invalidField argument is the YAML key (e.g.
// "interval") of the field that failed checkResolved — rows whose
// backing key matches carry the down wash so the operator's eye lands
// on the failing field.
templ resolvedRows(r *config.KubeConfig, invalidField string) {
	@resolvedKV("scheme", r.Scheme, "scheme", invalidField)
	@resolvedKV("path", r.Path, "path", invalidField)
	@resolvedKV("http method", r.HTTPMethod, "httpMethod", invalidField)
	if "acceptedStatusCodes" == invalidField {
		@resolvedKV("accepted codes", FormatTraceList(intsToTraceList(r.AcceptedStatusCodes)), "acceptedStatusCodes", invalidField)
	} else if len(r.AcceptedStatusCodes) > 0 {
		@kvHTTPCodes("accepted codes", r.AcceptedStatusCodes)
	}
	@resolvedKV("interval", humanInterval(r.Interval.AsDuration()), "interval", invalidField)
	@resolvedKV("timeout", humanInterval(r.Timeout.AsDuration()), "timeout", invalidField)
	@resolvedKV("retries", intToString(r.Retries), "retries", invalidField)
	@resolvedKV("retry backoff", humanInterval(r.RetryBackoff.AsDuration()), "retryBackoff", invalidField)
	@resolvedKV("follow redirects", boolYesNo(r.FollowRedirects), "followRedirects", invalidField)
	@resolvedKV("tls insecure skip verify", boolYesNo(r.TLSInsecureSkipVerify), "tlsInsecureSkipVerify", invalidField)
	if r.Proxy != "" {
		@resolvedKV("proxy", r.Proxy, "proxy", invalidField)
	}
	@resolvedKV("reminder interval", humanInterval(r.ReminderInterval.AsDuration()), "reminderInterval", invalidField)
	if r.Scheme == "" || r.Scheme == "https" {
		@resolvedKV("ssl alert threshold", humanInterval(r.SSLAlertThreshold.AsDuration()), "sslAlertThreshold", invalidField)
		@resolvedKV("ssl escalation threshold", humanInterval(r.SSLEscalationThreshold.AsDuration()), "sslEscalationThreshold", invalidField)
		@resolvedKV("ssl reminder interval", humanInterval(r.SSLReminderInterval.AsDuration()), "sslReminderInterval", invalidField)
	}
	@resolvedKV("slack channel", r.Slack, "slack", invalidField)
	if len(r.Notify.Values) > 0 {
		@resolvedKV("notify", FormatTraceList(r.Notify.Values), "notify", invalidField)
	}
	if "tags" == invalidField {
		@resolvedKV("tags", FormatTraceList(r.Tags.Values), "tags", invalidField)
	} else if len(r.Tags.Values) > 0 {
		@kvTags("tags", r.Tags.Values, kvWideKeyWidth)
	}
	if len(r.DependsOn.Values) > 0 {
		@resolvedKV("depends on", FormatTraceList(r.DependsOn.Values), "dependsOn", invalidField)
	}
}

// resolvedKV renders one resolved-config field. The non-highlighted
// branch delegates straight to the shared KeyValue row so the Resolved
// card matches every other key-value row across the app; the
// highlighted branch carries the same shape plus the down wash,
// extended to the container's edges.
templ resolvedKV(label, value, key, invalidField string) {
	if key == invalidField {
		<div class="flex py-[9px] font-mono text-xs gap-2 bg-down-soft -mx-4 px-4">
			<span style={ "width:" + px(kvWideKeyWidth) } class="flex-none text-faint">{ label }</span>
			<span class="text-ink min-w-0 break-words">{ value }</span>
		</div>
	} else {
		@kvWide(label, value)
	}
}
