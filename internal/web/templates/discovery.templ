package templates

import (
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// DiscoveryStatus is what handleDiscoveryListing passes alongside the
// rows so the empty state can explain *why* the page is empty:
// auto-discovery off entirely vs. configured-but-no-ingresses-yet.
type DiscoveryStatus struct {
	KubeEnabled    bool          // cfg.Kube != nil
	ResyncInterval time.Duration // 0 when disabled
}

templ DiscoveryListing(rows []store.DiscoverySnapshotRow, status DiscoveryStatus) {
	@Layout("Auto-discovery") {
		<h1 class="text-xl font-semibold mb-3">Auto-discovery snapshot</h1>
		if len(rows) == 0 {
			@discoveryEmptyState(status)
		} else {
			<div class="mb-3 text-sm text-slate-600 dark:text-slate-400">{ summary(rows) }</div>
			<table class="w-full bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 overflow-hidden">
				<thead>
					<tr class="bg-slate-50 dark:bg-slate-800 text-left text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
						<th class="py-2 px-3">Namespace</th>
						<th class="py-2 px-3">Ingress</th>
						<th class="py-2 px-3">Host</th>
						<th class="py-2 px-3">Status</th>
						<th class="py-2 px-3">Reason</th>
						<th class="py-2 px-3">Monitor</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr class="border-b border-slate-100 dark:border-slate-800">
							<td class="py-2 px-3 text-sm">{ r.Namespace }</td>
							<td class="py-2 px-3 text-sm">{ r.IngressName }</td>
							<td class="py-2 px-3 text-sm">{ r.Host }</td>
							<td class="py-2 px-3 text-sm">@DiscoveryBadge(r.Status)</td>
							<td class="py-2 px-3 text-sm text-slate-500 dark:text-slate-400">
								if r.Reason != nil {
									{ *r.Reason }
								}
							</td>
							<td class="py-2 px-3 text-sm">
								if r.MonitorSlug != nil {
									<a class="text-blue-700 dark:text-blue-400 hover:underline" href={ templ.URL("/monitor/" + *r.MonitorSlug) }>{ *r.MonitorSlug }</a>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

// discoveryEmptyState picks one of three messages: kube block absent,
// kube enabled but reconcile pending, or kube enabled + nothing to
// see (real cluster, zero ingresses). The "pending" vs. "nothing"
// distinction is heuristic — there's no startup timestamp here, so
// we lean on resyncInterval to phrase the wait honestly.
templ discoveryEmptyState(s DiscoveryStatus) {
	if !s.KubeEnabled {
		<div class="rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 text-sm">
			<p class="font-medium text-slate-700 dark:text-slate-200 mb-1">Auto-discovery is disabled.</p>
			<p class="text-slate-500 dark:text-slate-400">The <code class="text-xs">kube</code> block is not set in <code class="text-xs">config.yaml</code>. Add one to start watching cluster ingresses — see <code class="text-xs">docs/config-example.yaml</code>.</p>
		</div>
	} else {
		<div class="rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 text-sm">
			<p class="font-medium text-slate-700 dark:text-slate-200 mb-1">Auto-discovery is enabled — no ingresses observed yet.</p>
			<p class="text-slate-500 dark:text-slate-400">
				The watcher reconciles every { humanInterval(s.ResyncInterval) }. If your cluster has Ingress resources and this stays empty, check the app logs for <code class="text-xs">kube reconcile failed</code> or RBAC errors on <code class="text-xs">networking.k8s.io/ingresses</code>.
			</p>
		</div>
	}
}

templ DiscoveryDetail(row store.DiscoverySnapshotRow) {
	@Layout("Discovery — "+row.IngressName) {
		<h1 class="text-xl font-semibold mb-3">{ row.Namespace }/{ row.IngressName } · { row.Host }</h1>
		<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4 mb-6">
			<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Snapshot</h2>
			<dl>
				<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
					<dt class="text-sm text-slate-500 dark:text-slate-400">Status</dt>
					<dd class="text-sm col-span-2">@DiscoveryBadge(row.Status)</dd>
				</div>
				if row.Reason != nil {
					@kv("Reason", *row.Reason)
				}
				if row.PresetSlug != nil {
					@kv("Preset", *row.PresetSlug)
				}
				if row.MonitorSlug != nil {
					@kv("Materialized monitor", *row.MonitorSlug)
				}
			</dl>
		</section>
		<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4">
			<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Annotations</h2>
			if len(row.Annotations) == 0 {
				<p class="text-sm text-slate-500 dark:text-slate-400">No annotations.</p>
			} else {
				<dl>
					for _, k := range sortedKeys(row.Annotations) {
						@kv(k, row.Annotations[k])
					}
				</dl>
			}
		</section>
	}
}
