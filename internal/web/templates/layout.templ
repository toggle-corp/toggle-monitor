package templates

import (
	"fmt"
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// themeBootScript runs synchronously in <head> before paint so the
// page never flashes the wrong theme. Reads the saved preference
// ("light" | "dark" | "system" — default system) from localStorage and
// applies the `dark` class on <html> per the OS media query when in
// system mode.
script themeBoot() {
	(function() {
		try {
			var pref = localStorage.getItem("toggle-monitor-theme") || "system";
			var resolved = pref;
			if (pref === "system") {
				resolved = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}
			document.documentElement.classList.toggle("dark", resolved === "dark");
			document.documentElement.setAttribute("data-theme", pref);
			if (pref === "system" && window.matchMedia) {
				window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function(e) {
					if ((localStorage.getItem("toggle-monitor-theme") || "system") === "system") {
						document.documentElement.classList.toggle("dark", e.matches);
					}
				});
			}
		} catch (_) {}
	})();
}

// themeToggleScript wires the three nav buttons. Highlight comes from
// the `data-theme` attribute set by themeBoot + this handler.
script themeToggle() {
	(function() {
		function apply(pref) {
			try { localStorage.setItem("toggle-monitor-theme", pref); } catch (_) {}
			var resolved = pref;
			if (pref === "system") {
				resolved = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}
			document.documentElement.classList.toggle("dark", resolved === "dark");
			document.documentElement.setAttribute("data-theme", pref);
		}
		document.querySelectorAll("[data-theme-set]").forEach(function(btn) {
			btn.addEventListener("click", function() { apply(btn.getAttribute("data-theme-set")); });
		});
	})();
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — toggle-monitor</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			@themeBoot()
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
		</head>
		<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen">
			<nav class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-6 py-3 flex items-center gap-6 mb-6">
				<a href="/" class="font-semibold text-slate-900 dark:text-slate-100">toggle-monitor</a>
				<a href="/" class="text-sm text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">Home</a>
				<a href="/monitors" class="text-sm text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">Monitors</a>
				<a href="/groups" class="text-sm text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">Groups</a>
				<a href="/discovery" class="text-sm text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100">Discovery</a>
				@themeSwitcher()
			</nav>
			<main class="max-w-screen-2xl mx-auto px-6 pb-12">
				{ children... }
			</main>
			@themeToggle()
		</body>
	</html>
}

// themeSwitcher renders the three-button segmented control. The
// currently-selected button is styled via the `[data-theme=...]
// [data-theme-set=...]` attribute selectors in input.css.
templ themeSwitcher() {
	<div class="ml-auto inline-flex rounded border border-slate-200 dark:border-slate-700 overflow-hidden text-sm" role="group" aria-label="Theme">
		<button type="button" data-theme-set="light" title="Light" aria-label="Light theme"
			class="px-2 py-1 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">☀</button>
		<button type="button" data-theme-set="dark" title="Dark" aria-label="Dark theme"
			class="px-2 py-1 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border-l border-slate-200 dark:border-slate-700">☾</button>
		<button type="button" data-theme-set="system" title="System" aria-label="System theme"
			class="px-2 py-1 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border-l border-slate-200 dark:border-slate-700">⌂</button>
	</div>
}

templ DBUnavailable() {
	@Layout("Database unavailable") {
		<div class="rounded border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-950 p-6 text-amber-900 dark:text-amber-200">
			<h1 class="font-semibold text-lg mb-1">Database temporarily unavailable</h1>
			<p class="text-sm">The toggle-monitor UI couldn't reach Postgres. Monitor checks continue running where possible; reload in a moment.</p>
		</div>
	}
}

templ StatusBadge(status string) {
	if status == "up" {
		<span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">UP</span>
	} else if status == "down" {
		<span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300">DOWN</span>
	} else if status == "temporary-paused" {
		<span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">PAUSED</span>
	} else {
		<span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">{ status }</span>
	}
}

// HTTPStatusBadge renders an HTTP status code as a colored chip:
// 2xx → emerald, 3xx → amber, 4xx/5xx → rose.
templ HTTPStatusBadge(code int) {
	<span class={ "inline-block px-2 py-0.5 rounded text-xs font-medium tabular-nums", httpCodeBadgeClasses(code) }>{ fmt.Sprint(code) }</span>
}

// EventTypeBadge colors the alert-event chip on the homepage feed
// and the per-monitor history (open/resolve/reminder + ssl_ variants).
templ EventTypeBadge(t string) {
	<span class={ "inline-block px-2 py-0.5 rounded text-xs font-medium", eventTypeBadgeClasses(t) }>{ t }</span>
}

// SSLBadge colors the per-monitor SSL status chip.
templ SSLBadge(s string) {
	<span class={ "inline-block px-2 py-0.5 rounded text-xs font-medium", sslBadgeClasses(s) }>{ s }</span>
}

// DiscoveryBadge colors the discovery snapshot row status.
templ DiscoveryBadge(s string) {
	<span class={ "inline-block px-2 py-0.5 rounded text-xs font-medium", discoveryBadgeClasses(s) }>{ s }</span>
}

// GroupLink renders a group slug as a clickable mono chip linking
// to /group/<slug>. Shared between the /monitors listing, the
// detail page's Group field, and the config dialog so the slug
// always looks the same and always navigates the same way.
templ GroupLink(slug string) {
	<a class="text-blue-700 dark:text-blue-400 hover:underline" href={ templ.URL("/group/" + slug) }>
		<code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{ slug }</code>
	</a>
}

// MonitorName renders the monitor's display name with the kube
// namespace lifted into a monospace chip — kube friendly names from
// merger.formatFriendlyName arrive as "(my-team) api-health", and
// the namespace boundary reads at a glance when it has its own
// visual treatment. Static monitors lack the prefix and render as
// a single plain span. Callers wrap this fragment in their own
// element (<a> for listings, <h1> for the detail page heading)
// using inline-flex + gap-1.5 to keep the chip beside the label.
templ MonitorName(name string) {
	if ns := kubeNamePrefix(name); ns != "" {
		<code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 shrink-0">{ ns }</code>
		<span class="truncate">{ kubeNameRest(name) }</span>
	} else {
		<span class="truncate">{ name }</span>
	}
}

// Timestamp renders an RFC3339 UTC stamp followed by a dim
// human-readable diff (e.g. "5m ago"). Empty for the zero time so
// callers can omit them safely.
templ Timestamp(t time.Time) {
	if !t.IsZero() {
		<span class="tabular-nums">{ t.UTC().Format(time.RFC3339) }</span>
		<span class="text-xs text-slate-500 dark:text-slate-500 ml-1">({ humanDuration(t) })</span>
	}
}

// MonitorRow is one row in the listing table. The URL is a real
// clickable link (target=_blank so the operator's listing tab stays
// open), and the last error — when present — sits dim under the URL
// so a glance at the listing is enough to triage a flood of failures.
templ MonitorRow(m store.MonitorRow) {
	<tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/60 align-top">
		<td class="py-2 px-3">
			<a class="text-blue-700 dark:text-blue-400 hover:underline inline-flex items-center gap-1.5" href={ templ.URL("/monitor/" + m.Slug) }>
				@MonitorName(m.FriendlyName)
			</a>
		</td>
		<td class="py-2 px-3 text-sm">@GroupLink(m.GroupSlug)</td>
		<td class="py-2 px-3">@StatusBadge(string(m.Status))</td>
		<td class="py-2 px-3 text-sm">
			<a class="text-slate-500 dark:text-slate-400 hover:text-blue-700 dark:hover:text-blue-400 hover:underline break-all" href={ templ.URL(m.URL) } target="_blank" rel="noopener noreferrer">{ m.URL }</a>
			if m.LastError != nil && *m.LastError != "" {
				<div class="text-xs text-rose-700 dark:text-rose-400 mt-0.5 break-words"><code>{ *m.LastError }</code></div>
			}
		</td>
		<td class="py-2 px-3 text-sm">
			if m.LastStatusCode != nil && *m.LastStatusCode != 0 {
				@HTTPStatusBadge(*m.LastStatusCode)
			} else {
				<span class="text-slate-400 dark:text-slate-600">—</span>
			}
		</td>
		<td class="py-2 px-3 text-sm text-slate-500 dark:text-slate-400 whitespace-nowrap">
			if m.LastCheckedAt != nil {
				<span title={ m.LastCheckedAt.UTC().Format(time.RFC3339) }>{ humanDuration(*m.LastCheckedAt) }</span>
			} else {
				—
			}
		</td>
		<td class="py-2 px-3 text-xs text-slate-600 dark:text-slate-400">
			if len(m.DependsOn) > 0 {
				for i, dep := range m.DependsOn {
					if i > 0 {
						<span>, </span>
					}
					<a class="hover:text-blue-700 dark:hover:text-blue-400 hover:underline" href={ templ.URL("/monitor/" + dep) }><code>{ dep }</code></a>
				}
			} else {
				<span class="text-slate-400 dark:text-slate-600">—</span>
			}
		</td>
		<td class="py-2 px-3 text-sm whitespace-nowrap">
			if m.SSLExpiresAt != nil {
				<span title={ m.SSLExpiresAt.UTC().Format(time.RFC3339) } class="text-slate-500 dark:text-slate-400">{ humanDuration(*m.SSLExpiresAt) }</span>
			} else {
				<span class="text-slate-400 dark:text-slate-600">—</span>
			}
		</td>
	</tr>
}
