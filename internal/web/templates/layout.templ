package templates

import "github.com/toggle-corp/toggle-monitor/internal/store"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — toggle-monitor</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
		</head>
		<body class="bg-slate-50 text-slate-900 min-h-screen">
			<nav class="bg-white border-b border-slate-200 px-6 py-3 flex items-center gap-6 mb-6">
				<a href="/" class="font-semibold text-slate-900">toggle-monitor</a>
				<a href="/" class="text-sm text-slate-600 hover:text-slate-900">Home</a>
				<a href="/monitors" class="text-sm text-slate-600 hover:text-slate-900">Monitors</a>
				<a href="/discovery" class="text-sm text-slate-600 hover:text-slate-900">Discovery</a>
			</nav>
			<main class="max-w-6xl mx-auto px-6 pb-12">
				{ children... }
			</main>
		</body>
	</html>
}

templ DBUnavailable() {
	@Layout("Database unavailable") {
		<div class="rounded border border-amber-300 bg-amber-50 p-6 text-amber-900">
			<h1 class="font-semibold text-lg mb-1">Database temporarily unavailable</h1>
			<p class="text-sm">The toggle-monitor UI couldn't reach Postgres. Monitor checks continue running where possible; reload in a moment.</p>
		</div>
	}
}

templ StatusBadge(status string) {
	if status == "up" {
		<span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800">UP</span>
	} else if status == "down" {
		<span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-rose-100 text-rose-800">DOWN</span>
	} else if status == "temporary-paused" {
		<span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700">PAUSED</span>
	} else {
		<span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700">{ status }</span>
	}
}

// MonitorRow is one row in the listing table.
templ MonitorRow(m store.MonitorRow) {
	<tr class="border-b border-slate-100 hover:bg-slate-50">
		<td class="py-2 px-3"><a class="text-blue-700 hover:underline" href={ templ.URL("/monitor/" + m.Slug) }>{ m.FriendlyName }</a></td>
		<td class="py-2 px-3 text-sm text-slate-600">{ m.GroupSlug }</td>
		<td class="py-2 px-3">@StatusBadge(string(m.Status))</td>
		<td class="py-2 px-3 text-sm text-slate-500">{ m.URL }</td>
	</tr>
}
