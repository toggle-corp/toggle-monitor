package templates

import (
	"fmt"
	"strings"
	"time"
)

// themeBootScript runs synchronously in <head> before paint so the
// page never flashes the wrong theme. Reads the saved preference
// ("light" | "dark" | "system" — default system) from localStorage and
// applies the `dark` class on <html> per the OS media query when in
// system mode.
script themeBoot() {
	(function() {
		try {
			var pref = localStorage.getItem("toggle-monitor-theme") || "system";
			var resolved = pref;
			if (pref === "system") {
				resolved = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}
			document.documentElement.classList.toggle("dark", resolved === "dark");
			document.documentElement.setAttribute("data-theme", pref);
			if (pref === "system" && window.matchMedia) {
				window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function(e) {
					if ((localStorage.getItem("toggle-monitor-theme") || "system") === "system") {
						document.documentElement.classList.toggle("dark", e.matches);
					}
				});
			}
		} catch (_) {}
	})();
}

// themeToggleScript wires the three nav buttons. Highlight comes from
// the `data-theme` attribute set by themeBoot + this handler.
script themeToggle() {
	(function() {
		function apply(pref) {
			try { localStorage.setItem("toggle-monitor-theme", pref); } catch (_) {}
			var resolved = pref;
			if (pref === "system") {
				resolved = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}
			document.documentElement.classList.toggle("dark", resolved === "dark");
			document.documentElement.setAttribute("data-theme", pref);
		}
		document.querySelectorAll("[data-theme-set]").forEach(function(btn) {
			btn.addEventListener("click", function() { apply(btn.getAttribute("data-theme-set")); });
		});
	})();
}

// navLinks are the operator sections, in bar order. NavMeta.Active
// names which one owns the current request.
var navLinks = []Crumb{
	{Label: "Home", Href: "/"},
	{Label: "Monitors", Href: "/monitors"},
	{Label: "Status", Href: "/status"},
	{Label: "Discovery", Href: "/discovery"},
	{Label: "Alerts", Href: "/alerts"},
	{Label: "Issues", Href: "/issues"},
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — toggle-monitor</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			@themeBoot()
			<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
		</head>
		<body class="bg-bg text-ink font-sans min-h-screen antialiased">
			{{ nav := NavFromCtx(ctx) }}
			<nav class="sticky top-0 z-30 bg-bg border-b border-border px-6 h-[53px] flex items-center gap-[22px]">
				<a href="/" class="inline-flex items-center gap-2 font-bold text-ink text-[14.5px] tracking-[-.01em] whitespace-nowrap rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
					<span class="w-[7px] h-[7px] rounded-sm bg-up-mark" aria-hidden="true"></span>
					toggle-monitor
				</a>
				<div class="flex gap-0.5 text-[13px] whitespace-nowrap">
					for _, l := range navLinks {
						@navLink(l, nav)
					}
				</div>
				@themeSwitcher()
			</nav>
			<main class="max-w-screen-2xl mx-auto px-6 py-6 flex flex-col gap-[22px]">
				{ children... }
			</main>
			@themeToggle()
		</body>
	</html>
}

// navLink renders one nav entry, marking the active section and hanging
// the open-issue count off the Issues tab.
templ navLink(l Crumb, nav NavMeta) {
	<a
		href={ templ.URL(l.Href) }
		if l.Href == nav.Active {
			aria-current="page"
		}
		class={
			"inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
			templ.KV("text-ink font-semibold", l.Href == nav.Active),
			templ.KV("text-muted", l.Href != nav.Active),
		}
	>
		{ l.Label }
		if l.Href == "/issues" && nav.IssueCount > 0 {
			<span data-nav-issues>
				@Chip(ToneDown) {
					{ fmt.Sprint(nav.IssueCount) }
				}
			</span>
		}
	</a>
}

// themeSwitcher renders the three-cell segmented control. The
// currently-selected cell is styled via the `[data-theme=...]
// [data-theme-set=...]` attribute selectors in input.css, which read the
// raw preference so "system" stays distinct from whichever of
// light/dark it currently resolves to.
templ themeSwitcher() {
	<div class="ml-auto inline-flex items-center rounded-md border border-border overflow-hidden font-mono text-2xs font-medium" role="group" aria-label="Theme">
		@themeSwitcherCell("light", "☀", "Light theme")
		@themeSwitcherCell("dark", "☾", "Dark theme")
		@themeSwitcherCell("system", "⌂", "System theme")
	</div>
}

templ themeSwitcherCell(pref, glyph, label string) {
	<button
		type="button"
		data-theme-set={ pref }
		title={ label }
		aria-label={ label }
		class="inline-flex items-center px-2.5 py-1 min-h-[28px] text-muted transition-colors hover:bg-surface-hover hover:text-ink border-l border-border first:border-l-0 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent"
	>{ glyph }</button>
}

templ DBUnavailable() {
	@Layout("Database unavailable") {
		@Banner(ToneWarn) {
			Database temporarily unavailable — the toggle-monitor UI couldn't reach Postgres.
			Monitor checks continue running where possible; reload in a moment.
		}
	}
}

// StatusBadge renders a monitor's live status in the shared status
// vocabulary — a colored mark plus its label.
templ StatusBadge(status string) {
	@Badge(MonitorTone(status, false), statusBadgeLabelFor(status))
}

// KindBadge renders a monitor's probe kind (e.g. SMTP) as an accent
// chip. HTTP monitors are the default and don't render a badge;
// callers gate on kind before invoking this.
templ KindBadge(kind string) {
	@Chip(ToneAccent) {
		{ strings.ToUpper(kind) }
	}
}

// ArchivedChip stands in for a live status badge on soft-deleted
// monitors. Reused on the detail page header and in the listing's Name
// cell when archived rows are visible.
templ ArchivedChip() {
	@Badge(ToneArchived, "archived")
}

// HTTPStatusBadge renders an HTTP status code as a toned chip:
// 2xx reads as up, 3xx as a warning, 4xx/5xx as down.
templ HTTPStatusBadge(code int) {
	@Chip(HTTPCodeTone(code)) {
		{ fmt.Sprint(code) }
	}
}

// EventTypeBadge colors the alert-event kind on the homepage feed and
// the per-monitor history (open/resolve/reminder + ssl_ variants). It
// is bare colored text rather than a chip: the event kind is the first
// column of the feed and reads as a heading for its row.
templ EventTypeBadge(t string) {
	<span data-status={ string(EventTone(t)) } class={ "font-mono text-xs font-semibold", toneText(EventTone(t)) }>{ t }</span>
}

// SSLCell renders the compact SSL column used in both /monitors and
// /status/<slug>: short-label chip + relative expiry. ssl-expiring
// rows whose cert has already crossed expires_at render with a red
// "expired" chip (presentation-only — the persisted status is
// unchanged, so alerting cadence keeps working). Nil status renders
// an em-dash so a brand-new monitor that hasn't been probed yet looks
// distinct from a deliberately skipped one. The absolute RFC3339
// timestamp lives in `title=` for the rare moment an operator needs
// it.
templ SSLCell(status string, expiresAt *time.Time) {
	{{ kind := SSLCellState(status, expiresAt) }}
	if kind == "" {
		@Dash()
	} else {
		<span data-ssl={ kind } data-status={ string(SSLTone(kind)) } class={ "font-mono text-xs whitespace-nowrap", toneText(SSLTone(kind)) }><span>{ kind }</span>
			if expiresAt != nil && kind != "skipped" {
				<span title={ expiresAt.UTC().Format(time.RFC3339) } class="text-dim"> · { humanDuration(*expiresAt) }</span>
			}
		</span>
	}
}

// DiscoveryBadge colors the discovery snapshot row status.
templ DiscoveryBadge(s string) {
	@Badge(DiscoveryTone(s), s)
}

// TagChip renders a single tag as a compact mono chip — used in the
// monitor listing's Tags column and in the monitor detail page. Tags
// are non-clickable in v1; if needed later they can wrap in an
// /monitors?tag=<x> link.
templ TagChip(tag string) {
	@Chip(ToneNeutral) {
		{ tag }
	}
}

// Dash is the placeholder for a cell with no value. A brand-new monitor
// that hasn't been probed yet should look distinct from one whose value
// is genuinely empty, so this is used only for the latter.
templ Dash() {
	<span class="text-dim" aria-label="none">—</span>
}

// MonitorURLCell renders the two affordances a monitor URL implies on
// the status page: a "🔗 host" link pointing at the application root
// (scheme + host) so the operator can open the app itself, and the
// full URL underneath as a smaller link pointing at the health-check
// endpoint the monitor actually probes. Unparseable URLs fall back to
// a single plain link on the full URL.
templ MonitorURLCell(raw string) {
	{{ host := hostFromURL(raw) }}
	{{ root := rootURL(raw) }}
	if raw == "" {
		@Dash()
	} else if host == "" || root == "" {
		@ExternalLink(raw, "Open "+raw) {
			<span class="break-all">{ raw }</span>
		}
	} else {
		<div class="flex flex-col gap-0.5 min-w-0">
			@ExternalLink(root, "Open "+root) {
				<span class="truncate">{ host }</span>
			}
			<a class="font-mono text-2xs text-faint hover:text-accent hover:underline underline-offset-2 break-all rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL(raw) } target="_blank" rel="noopener noreferrer" title="Open health-check endpoint">{ raw }</a>
		</div>
	}
}

// MonitorName renders the monitor's display name in the design's path
// form. Kube friendly names from merger.formatFriendlyName arrive as
// "(my-team) api-health"; the namespace becomes the dimmed scope of
// "my-team/api-health" so the eye lands on the name when scanning a
// column. Static monitors have no prefix and render as "/name".
templ MonitorName(name string) {
	@MonitorID(kubeNamePrefix(name), kubeNameRest(name))
}

// Timestamp renders an RFC3339 UTC stamp followed by a dim
// human-readable diff (e.g. "5m ago"). Empty for the zero time so
// callers can omit them safely.
templ Timestamp(t time.Time) {
	if !t.IsZero() {
		<span class="font-mono tabular-nums">{ t.UTC().Format(time.RFC3339) }</span>
		<span class="font-mono text-2xs text-dim ml-1">({ humanDuration(t) })</span>
	}
}
