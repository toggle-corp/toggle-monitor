package templates

import (
	"fmt"
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// statTile renders one of the Overview cards. The whole card is a
// link to /monitors with a pre-applied filter. kind drives the accent
// (emerald/rose/amber/slate) and only activates when count > 0.
templ statTile(label string, count int, kind, href string) {
	<a href={ templ.URL(href) } class={ "block rounded border bg-white dark:bg-slate-900 p-4 transition hover:shadow-sm", statTileAccent(kind, count) }>
		<div class="text-sm text-slate-500 dark:text-slate-400">{ label }</div>
		<div class={ "text-2xl font-semibold mt-1 tabular-nums", statTileCount(kind, count) }>{ fmt.Sprint(count) }</div>
	</a>
}

// MappingEntry is the per-row payload the homepage renders in the
// "Slack mapping health" panel. Mirrors web.MappingEntry so this
// package doesn't import web (it's imported by web).
type MappingEntry struct {
	Slug    string
	ID      string
	Reason  string
	Checked time.Time
}

// MappingHealth carries the whole panel's state. Empty Invalid →
// quiet panel; non-empty → flagged entries listed.
type MappingHealth struct {
	Invalid []MappingEntry
	LastRun time.Time
}

templ Homepage(stats store.HomepageStats, alerts store.LatestAlertsListing, page, perPage int, mapping MappingHealth) {
	@Layout("Home") {
		<section class="mb-8">
			<h1 class="text-xl font-semibold mb-3">Overview</h1>
			<div class="grid grid-cols-2 md:grid-cols-5 gap-3">
				@statTile("Up", stats.Up, "up", "/monitors?status=up")
				@statTile("Down", stats.Down, "down", "/monitors?status=down")
				@statTile("Paused", stats.TemporaryPaused, "warn", "/monitors?status=temporary-paused")
				@statTile("SSL expiring", stats.SSLExpiring, "warn", "/monitors?ssl=ssl-expiring")
				@statTile("SSL skipped", stats.SSLSkipped, "", "/monitors?ssl=ssl-skipped")
			</div>
			<div class="mt-3">
				<a href="/monitors" class="text-sm text-blue-700 dark:text-blue-400 hover:underline">All monitors →</a>
			</div>
		</section>

		if len(mapping.Invalid) > 0 {
			<section class="mb-6">
				<h2 class="text-lg font-semibold mb-2 text-rose-700 dark:text-rose-400">Slack mapping issues</h2>
				<div class="bg-white dark:bg-slate-900 rounded border border-rose-200 dark:border-rose-800 p-4">
					<p class="text-sm text-slate-500 dark:text-slate-400 mb-2">
						{ fmt.Sprint(len(mapping.Invalid)) } userMapping entry/entries failed validation. Fix the IDs in config.yaml or your workspace and re-run the validator (next pass: every 24h, or restart the binary).
					</p>
					<ul class="text-sm divide-y divide-slate-100 dark:divide-slate-800">
						for _, e := range mapping.Invalid {
							<li class="py-2 flex gap-3">
								<span class="font-medium w-32">{ e.Slug }</span>
								<code class="text-slate-700 dark:text-slate-300 w-32">{ e.ID }</code>
								<span class="text-rose-700 dark:text-rose-400">{ e.Reason }</span>
							</li>
						}
					</ul>
					if !mapping.LastRun.IsZero() {
						<p class="text-xs text-slate-400 dark:text-slate-500 mt-2">
							Last checked @Timestamp(mapping.LastRun)
						</p>
					}
				</div>
			</section>
		}

		<section>
			<h2 class="text-lg font-semibold mb-2">Latest alerts</h2>
			if len(alerts.Items) == 0 {
				<p class="text-sm text-slate-500 dark:text-slate-400">No alerts yet.</p>
			} else {
				<ul class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 divide-y divide-slate-100 dark:divide-slate-800">
					for _, ev := range alerts.Items {
						<li class="py-2 px-3 text-sm flex flex-wrap items-center gap-3">
							<span class="w-24">@EventTypeBadge(string(ev.Type))</span>
							<a class="text-blue-700 dark:text-blue-400 hover:underline w-40 truncate" href={ templ.URL("/monitor/" + ev.MonitorSlug) }>{ ev.FriendlyName }</a>
							<span class="text-slate-500 dark:text-slate-400">@Timestamp(ev.At)</span>
							if ev.StatusCode != nil {
								@HTTPStatusBadge(*ev.StatusCode)
							}
							if ev.Error != nil && *ev.Error != "" {
								<span class="text-rose-700 dark:text-rose-400 truncate">{ *ev.Error }</span>
							}
						</li>
					}
				</ul>
				@Paginator("/", page, perPage, alerts.Total, nil)
			}
		</section>
	}
}
