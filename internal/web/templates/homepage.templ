package templates

import (
	"fmt"
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

templ statTile(label string, count int, accent string) {
	<div class={ "rounded border bg-white p-4", accent }>
		<div class="text-sm text-slate-500">{ label }</div>
		<div class="text-2xl font-semibold mt-1">{ fmt.Sprint(count) }</div>
	</div>
}

// MappingEntry is the per-row payload the homepage renders in the
// "Slack mapping health" panel. Mirrors web.MappingEntry so this
// package doesn't import web (it's imported by web).
type MappingEntry struct {
	Slug    string
	ID      string
	Reason  string
	Checked time.Time
}

// MappingHealth carries the whole panel's state. Empty Invalid →
// quiet panel; non-empty → flagged entries listed.
type MappingHealth struct {
	Invalid []MappingEntry
	LastRun time.Time
}

templ Homepage(stats store.HomepageStats, alerts store.LatestAlertsListing, page, perPage int, mapping MappingHealth) {
	@Layout("Home") {
		<section class="mb-8">
			<h1 class="text-xl font-semibold mb-3">Overview</h1>
			<div class="grid grid-cols-2 md:grid-cols-5 gap-3">
				@statTile("Up", stats.Up, "border-emerald-200")
				@statTile("Down", stats.Down, "border-rose-200")
				@statTile("Paused", stats.TemporaryPaused, "border-slate-200")
				@statTile("SSL expiring", stats.SSLExpiring, "border-amber-200")
				@statTile("SSL skipped", stats.SSLSkipped, "border-slate-200")
			</div>
			<div class="mt-3">
				<a href="/monitors" class="text-sm text-blue-700 hover:underline">All monitors →</a>
			</div>
		</section>

		if len(mapping.Invalid) > 0 {
			<section class="mb-6">
				<h2 class="text-lg font-semibold mb-2 text-rose-700">Slack mapping issues</h2>
				<div class="bg-white rounded border border-rose-200 p-4">
					<p class="text-sm text-slate-500 mb-2">
						{ fmt.Sprint(len(mapping.Invalid)) } userMapping entry/entries failed validation. Fix the IDs in config.yaml or your workspace and re-run the validator (next pass: every 24h, or restart the binary).
					</p>
					<ul class="text-sm divide-y divide-slate-100">
						for _, e := range mapping.Invalid {
							<li class="py-2 flex gap-3">
								<span class="font-medium w-32">{ e.Slug }</span>
								<code class="text-slate-700 w-32">{ e.ID }</code>
								<span class="text-rose-700">{ e.Reason }</span>
							</li>
						}
					</ul>
					if !mapping.LastRun.IsZero() {
						<p class="text-xs text-slate-400 mt-2">Last checked { mapping.LastRun.UTC().Format(time.RFC3339) }</p>
					}
				</div>
			</section>
		}

		<section>
			<h2 class="text-lg font-semibold mb-2">Latest alerts</h2>
			if len(alerts.Items) == 0 {
				<p class="text-sm text-slate-500">No alerts yet.</p>
			} else {
				<ul class="bg-white rounded border border-slate-200 divide-y divide-slate-100">
					for _, ev := range alerts.Items {
						<li class="py-2 px-3 text-sm flex gap-3">
							<span class="font-medium w-24">{ string(ev.Type) }</span>
							<a class="text-blue-700 hover:underline w-40" href={ templ.URL("/monitor/" + ev.MonitorSlug) }>{ ev.MonitorSlug }</a>
							<span class="text-slate-500">{ ev.At.UTC().Format(time.RFC3339) }</span>
							if ev.StatusCode != nil {
								<span class="text-slate-700">HTTP { fmt.Sprint(*ev.StatusCode) }</span>
							}
							if ev.Error != nil && *ev.Error != "" {
								<span class="text-rose-700 truncate">{ *ev.Error }</span>
							}
						</li>
					}
				</ul>
				@Paginator("/", page, perPage, alerts.Total, nil)
			}
		</section>
	}
}
