package templates

import (
	"fmt"
	"strings"
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// statTile renders one of the Overview cards. The whole card is a
// link to /monitors with a pre-applied filter. kind drives the accent
// (emerald/rose/amber/slate) and only activates when count > 0.
templ statTile(label string, count int, kind, href string) {
	<a href={ templ.URL(href) } class={ "block rounded border bg-white dark:bg-slate-900 p-4 transition hover:shadow-sm", statTileAccent(kind, count) }>
		<div class="text-sm text-slate-500 dark:text-slate-400">{ label }</div>
		<div class={ "text-2xl font-semibold mt-1 tabular-nums", statTileCount(kind, count) }>{ fmt.Sprint(count) }</div>
	</a>
}

// StatusPageStats is the per-status-page rollup — same metric
// vocabulary as the global Overview, scoped to the monitors any
// section of the page selects. Computed by the web layer at render
// time. Powers both the /status index tiles and the at-a-glance
// stats row on /status/<slug>.
type StatusPageStats struct {
	Slug            string
	FriendlyName    string
	Description     string
	LogoURL         string
	Color           string // hex
	Total           int
	Up              int
	Down            int
	TemporaryPaused int
	SSLExpiring     int
	SSLExpired      int // presentation-only: ssl-expiring rows whose cert has crossed expires_at
	SSLSkipped      int
}

// pageBadgeKind picks the 3-state badge for a page rollup, mirroring
// status.templ's statusBadgeKind but driven by deduped page totals
// rather than per-section monitor lists.
func pageBadgeKind(s StatusPageStats) string {
	switch {
	case s.Total == 0:
		return "none"
	case s.Down > 0:
		return "down"
	case s.TemporaryPaused > 0 || s.SSLExpiring > 0:
		return "warn"
	default:
		return "up"
	}
}

// firstInitial returns the first letter of s upper-cased, "?" when s
// is empty. Used as the avatar fallback when a status page has no
// logoUrl.
func firstInitial(s string) string {
	for _, r := range s {
		if r == ' ' || r == '\t' {
			continue
		}
		if r >= 'a' && r <= 'z' {
			return string(r - 32)
		}
		return string(r)
	}
	return "?"
}

// statusPageTile renders one status-page card on the /status index.
// Layout: a top stripe in the page colour, then a header band with
// logo + name + slug + 3-state badge, then optional description,
// then a stats footer with a large Total + only-when-non-zero
// problem chips so healthy pages stay calm.
templ statusPageTile(s StatusPageStats) {
	{{ kind := pageBadgeKind(s) }}
	<a href={ templ.URL("/status/" + s.Slug) } class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 overflow-hidden transition hover:shadow-md hover:-translate-y-0.5 hover:border-slate-300 dark:hover:border-slate-600">
		if s.Color != "" {
			<div class="h-1.5 w-full" style={ "background-color: " + s.Color }></div>
		} else {
			<div class="h-1.5 w-full bg-slate-200 dark:bg-slate-700"></div>
		}
		<div class="p-5 space-y-4">
			<div class="flex items-start gap-3">
				if s.LogoURL != "" {
					<img src={ s.LogoURL } alt="" class="h-11 w-11 rounded-md object-contain shrink-0 bg-slate-50 dark:bg-slate-800 p-1 border border-slate-200 dark:border-slate-700"/>
				} else {
					<div class={ "h-11 w-11 rounded-md flex items-center justify-center shrink-0 text-base font-semibold border border-slate-200 dark:border-slate-700", logoFallbackClasses(s.Color) } style={ logoFallbackStyle(s.Color) }>
						{ firstInitial(s.FriendlyName) }
					</div>
				}
				<div class="flex-1 min-w-0">
					<div class="flex items-center gap-2 flex-wrap">
						<h3 class="text-base font-semibold text-slate-900 dark:text-slate-100 truncate leading-tight">{ s.FriendlyName }</h3>
						<code class="font-mono text-[11px] px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 shrink-0">{ s.Slug }</code>
					</div>
					if s.Description != "" {
						<p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">{ s.Description }</p>
					}
				</div>
				<span class={ "shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border", statusBadgeClasses(kind) }>
					<span class={ "inline-block w-2 h-2 rounded-full", badgeDotClasses(kind) }></span>
					{ statusBadgeLabel(kind) }
				</span>
			</div>
			<div class="flex items-end justify-between gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
				<div class="shrink-0">
					<div class="text-3xl font-semibold tabular-nums text-slate-900 dark:text-slate-100 leading-none">{ fmt.Sprint(s.Total) }</div>
					<div class="text-[11px] uppercase tracking-wider text-slate-500 dark:text-slate-400 mt-1.5">
						if s.Total == 1 {
							monitor
						} else {
							monitors
						}
					</div>
				</div>
				<div class="flex flex-wrap items-center gap-1.5 justify-end">
					if s.Total == 0 {
						<span class="text-xs text-slate-500 dark:text-slate-400 italic">no monitors selected</span>
					} else {
						@problemChip("down", s.Down, "down")
						@problemChip("paused", s.TemporaryPaused, "warn")
						@problemChip("SSL expiring", s.SSLExpiring, "warn")
						@problemChip("SSL skipped", s.SSLSkipped, "")
						if s.Down == 0 && s.TemporaryPaused == 0 && s.SSLExpiring == 0 {
							<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
								all { fmt.Sprint(s.Up) } up
							</span>
						}
					}
				</div>
			</div>
		</div>
	</a>
}

// problemChip renders a small chip — only when count > 0 — so a
// healthy page card stays visually quiet and a degraded one
// surfaces what's wrong at a glance.
templ problemChip(label string, count int, kind string) {
	if count > 0 {
		<span class={ "inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium border", chipClasses(kind) }>
			<span class="tabular-nums font-semibold">{ fmt.Sprint(count) }</span>
			<span>{ label }</span>
		</span>
	}
}

// chipClasses returns the colour palette for a problem chip. Empty
// kind is the neutral slate variant for "SSL skipped" which isn't an
// active problem, just an audited fact.
func chipClasses(kind string) string {
	switch kind {
	case "down":
		return "bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-950/40 dark:text-rose-300 dark:border-rose-800"
	case "warn":
		return "bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800"
	default:
		return "bg-slate-100 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700"
	}
}

// badgeDotClasses returns the indicator-dot colour for the page
// badge. Solid emerald/rose, amber for warn, slate for none.
func badgeDotClasses(kind string) string {
	switch kind {
	case "down":
		return "bg-rose-500"
	case "warn":
		return "bg-amber-500"
	case "none":
		return "bg-slate-400"
	default:
		return "bg-emerald-500"
	}
}

// logoFallbackClasses styles the initial-letter avatar that stands in
// when a status page lacks a logoUrl. When the page has a color, we
// render a colored chip with white text via inline style (so any hex
// works); otherwise fall back to a neutral slate panel.
func logoFallbackClasses(color string) string {
	if color != "" {
		return "text-white"
	}
	return "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
}

func logoFallbackStyle(color string) string {
	if color == "" {
		return ""
	}
	return "background-color: " + color
}

// MappingEntry is the per-row payload the homepage renders in the
// "Slack mapping health" panel. Mirrors web.MappingEntry so this
// package doesn't import web (it's imported by web).
type MappingEntry struct {
	Slug    string
	ID      string
	Reason  string
	Checked time.Time
}

// MappingHealth carries the whole panel's state. Empty Invalid →
// quiet panel; non-empty → flagged entries listed.
type MappingHealth struct {
	Invalid []MappingEntry
	LastRun time.Time
}

// AnnotationIssue is one rejected annotation value (ADR-0009). The
// monitor it belongs to is still probing on the cascade value; this is
// a misconfiguration for the app team to fix, not an outage.
type AnnotationIssue struct {
	Slug        string
	Namespace   string
	IngressName string
	Host        string
	Field       string
	Key         string
	Scope       string
	Value       string
	Reason      string
}

// IssuesView bundles every source the /issues page renders. A struct
// rather than positional parameters so a fifth source can't silently
// land in the wrong argument slot.
type IssuesView struct {
	Mapping          MappingHealth
	InvalidDiscovery []store.DiscoverySnapshotRow
	MissingParents   []MissingParent
	Annotations      []AnnotationIssue

	// IgnoredDiscovery is capped at IgnoredPreviewMax rows; IgnoredTotal
	// is the uncapped count. A broad ignore rule (namespace: "test-*")
	// can match hundreds of Ingresses, and the page must not grow with
	// the cluster — /discovery is the place to page through them.
	IgnoredDiscovery []store.DiscoverySnapshotRow
	IgnoredTotal     int
}

// IgnoredPreviewMax is how many kube-ignored rows the /issues page
// lists before deferring to the /discovery link.
const IgnoredPreviewMax = 10

// Total is the issue count the nav badge and the page heading share.
// IgnoredDiscovery is excluded: an operator wrote the ignore: rule that
// produced those rows, so they are an acknowledgement, not an issue.
func (v IssuesView) Total() int {
	return len(v.Mapping.Invalid) + len(v.InvalidDiscovery) +
		len(v.MissingParents) + len(v.Annotations)
}

// MissingParent is one dependsOn reference that didn't resolve to a
// known monitor at lookup time. Surfaced on the /issues page so a
// typo or post-startup drift between config and DB doesn't stay
// buried in app logs.
type MissingParent struct {
	Parent   string
	Children []string
	LastSeen time.Time
}

templ Homepage(stats store.HomepageStats, alerts store.LatestAlertsListing, page, perPage int, mapping MappingHealth) {
	@Layout("Home") {
		<section class="mb-8">
			<h1 class="text-xl font-semibold mb-3">Overview</h1>
			<div class="grid grid-cols-2 md:grid-cols-5 gap-3">
				@statTile("Up", stats.Up, "up", "/monitors?status=up")
				@statTile("Down", stats.Down, "down", "/monitors?status=down")
				@statTile("Paused", stats.TemporaryPaused, "warn", "/monitors?status=temporary-paused")
				@statTile("SSL expiring", stats.SSLExpiring, "warn", "/monitors?ssl=ssl-expiring")
				@statTile("SSL skipped", stats.SSLSkipped, "", "/monitors?ssl=ssl-skipped")
			</div>
			<div class="mt-3 flex flex-wrap gap-4 text-sm">
				<a href="/monitors" class="text-blue-700 dark:text-blue-400 hover:underline">All monitors →</a>
				<a href="/status" class="text-blue-700 dark:text-blue-400 hover:underline">Status pages →</a>
			</div>
		</section>

		if len(mapping.Invalid) > 0 {
			<section class="mb-6">
				<h2 class="text-lg font-semibold mb-2 text-rose-700 dark:text-rose-400">Slack mapping issues</h2>
				<div class="bg-white dark:bg-slate-900 rounded border border-rose-200 dark:border-rose-800 p-4">
					<p class="text-sm text-slate-500 dark:text-slate-400 mb-2">
						{ fmt.Sprint(len(mapping.Invalid)) } userMapping entry/entries failed validation. Fix the IDs in config.yaml or your workspace and re-run the validator (next pass: every 24h, or restart the binary).
					</p>
					<ul class="text-sm divide-y divide-slate-100 dark:divide-slate-800">
						for _, e := range mapping.Invalid {
							<li class="py-2 flex gap-3">
								<span class="font-medium w-32">{ e.Slug }</span>
								<code class="text-slate-700 dark:text-slate-300 w-32">{ e.ID }</code>
								<span class="text-rose-700 dark:text-rose-400">{ e.Reason }</span>
							</li>
						}
					</ul>
					if !mapping.LastRun.IsZero() {
						<p class="text-xs text-slate-400 dark:text-slate-500 mt-2">
							<span>Last checked </span>
							@Timestamp(mapping.LastRun)
						</p>
					}
				</div>
			</section>
		}

		<section>
			<h2 class="text-lg font-semibold mb-2">Latest alerts</h2>
			if len(alerts.Items) == 0 {
				<p class="text-sm text-slate-500 dark:text-slate-400">No alerts yet.</p>
			} else {
				<ul class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 divide-y divide-slate-100 dark:divide-slate-800">
					for _, ev := range alerts.Items {
						<li class="py-2 px-3 text-sm flex flex-wrap items-center gap-3">
							<span class="w-24 shrink-0">@EventTypeBadge(string(ev.Type))</span>
							<a class="text-blue-700 dark:text-blue-400 hover:underline inline-flex items-center gap-1.5 min-w-0 max-w-[28rem]" href={ templ.URL("/monitor/" + ev.MonitorSlug) }>
								@MonitorName(ev.FriendlyName)
							</a>
							<span class="text-slate-500 dark:text-slate-400 shrink-0">@Timestamp(ev.At)</span>
							if ev.StatusCode != nil {
								@HTTPStatusBadge(*ev.StatusCode)
							}
							if ev.Error != nil && *ev.Error != "" {
								<span class="text-rose-700 dark:text-rose-400 truncate min-w-0">{ *ev.Error }</span>
							}
						</li>
					}
				</ul>
				@Paginator("/", page, perPage, alerts.Total, nil)
			}
		</section>
	}
}

// IssuesPage is the bare-minimum operator-awareness view: anything
// the system noticed at runtime that an operator probably wants to
// look at. It surfaces existing sources — Slack userMapping entries
// that failed the validator, discovery_snapshot rows stuck at
// "kube-invalid", rejected annotation values, and unresolved dependsOn
// parents. None requires new storage; each links out to the page where
// the operator already acts on that class of problem (the homepage
// mapping panel / the /discovery listing).
//
// A trailing "Skipped ingresses" section lists "kube-ignored" rows.
// Those are acknowledgements rather than issues, so they sit below the
// fold and stay out of Total() — but an operator reviewing the page
// needs to see what an ignore: rule swallowed, especially a rule
// written broadly enough to cover more than the wildcard it targeted.
templ IssuesPage(view IssuesView) {
	{{ mapping := view.Mapping }}
	{{ invalidDiscovery := view.InvalidDiscovery }}
	{{ ignoredDiscovery := view.IgnoredDiscovery }}
	{{ missingParents := view.MissingParents }}
	@Layout("Issues") {
		<h1 class="text-xl font-semibold mb-4 inline-flex items-center gap-2">
			Issues
			if total := view.Total(); total > 0 {
				<span class="inline-flex items-center justify-center min-w-[1.5rem] px-2 py-0.5 rounded-full text-sm font-medium bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300 tabular-nums">{ fmt.Sprint(total) }</span>
			}
		</h1>
		if view.Total() == 0 {
			<div class="bg-white dark:bg-slate-900 rounded border border-emerald-200 dark:border-emerald-800 p-6 text-center text-sm text-slate-500 dark:text-slate-400">
				<p>No issues detected.</p>
				<p class="text-xs mt-1">Slack mapping is healthy and no kube ingresses are in an invalid state.</p>
			</div>
		}
		if len(mapping.Invalid) > 0 {
			<section class="mb-6">
				<h2 class="text-lg font-semibold mb-2 text-rose-700 dark:text-rose-400">Slack mapping ({ fmt.Sprint(len(mapping.Invalid)) })</h2>
				<div class="bg-white dark:bg-slate-900 rounded border border-rose-200 dark:border-rose-800 p-4">
					<p class="text-sm text-slate-500 dark:text-slate-400 mb-2">
						userMapping entries that failed validation. Fix the IDs in config.yaml or your workspace.
					</p>
					<ul class="text-sm divide-y divide-slate-100 dark:divide-slate-800">
						for _, e := range mapping.Invalid {
							<li class="py-2 flex flex-wrap gap-3">
								<span class="font-medium w-32">{ e.Slug }</span>
								<code class="text-slate-700 dark:text-slate-300 w-32">{ e.ID }</code>
								<span class="text-rose-700 dark:text-rose-400">{ e.Reason }</span>
							</li>
						}
					</ul>
					if !mapping.LastRun.IsZero() {
						<p class="text-xs text-slate-400 dark:text-slate-500 mt-2">
							<span>Last checked </span>
							@Timestamp(mapping.LastRun)
						</p>
					}
				</div>
			</section>
		}
		if len(invalidDiscovery) > 0 {
			<section class="mb-6">
				<h2 class="text-lg font-semibold mb-2 text-rose-700 dark:text-rose-400">
					Kube-invalid ingresses ({ fmt.Sprint(len(invalidDiscovery)) })
					<a class="text-sm font-normal ml-2 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100" href="/discovery?status=kube-invalid">View all →</a>
				</h2>
				<div class="bg-white dark:bg-slate-900 rounded border border-rose-200 dark:border-rose-800 p-4">
					<p class="text-sm text-slate-500 dark:text-slate-400 mb-2">
						Ingresses the watcher saw but couldn't materialize into a monitor — a resolved value that failed validation, or a wildcard host no prober can resolve. Fix the value in <code class="font-mono">kube.match</code>; a wildcard host has no value to fix, so acknowledge it with a matching <code class="font-mono">ignore: true</code> rule instead.
					</p>
					<ul class="text-sm divide-y divide-slate-100 dark:divide-slate-800">
						for _, row := range invalidDiscovery {
							<li class="py-2 flex flex-wrap gap-3">
								<code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{ row.Namespace }</code>
								<span class="font-medium">{ row.IngressName }</span>
								<span class="text-slate-500 dark:text-slate-400">{ row.Host }</span>
								if row.Reason != nil {
									<span class="text-rose-700 dark:text-rose-400">{ *row.Reason }</span>
								}
							</li>
						}
					</ul>
				</div>
			</section>
		}
		if len(view.Annotations) > 0 {
			<section class="mb-6">
				<h2 class="text-lg font-semibold mb-2 text-amber-700 dark:text-amber-400">
					Rejected annotation values ({ fmt.Sprint(len(view.Annotations)) })
				</h2>
				<div class="bg-white dark:bg-slate-900 rounded border border-amber-200 dark:border-amber-800 p-4">
					<p class="text-sm text-slate-500 dark:text-slate-400 mb-2">
						Values an app team's chart put in an annotation that toggle-monitor could not use. Each monitor still probes on its cascade value, so this is a misconfiguration to fix — not an outage. Fix the annotation on the Ingress or Namespace.
					</p>
					<ul class="text-sm divide-y divide-slate-100 dark:divide-slate-800">
						for _, ai := range view.Annotations {
							<li class="py-2 flex flex-wrap gap-3 items-baseline">
								<code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{ ai.Namespace }</code>
								<a class="font-medium text-blue-700 dark:text-blue-400 hover:underline" href={ templ.SafeURL("/discovery/" + ai.Namespace + "/" + ai.IngressName + "/" + ai.Host) }>{ ai.IngressName }</a>
								<span class="text-slate-500 dark:text-slate-400">{ ai.Host }</span>
								<span class="text-slate-500 dark:text-slate-400">{ ai.Scope }</span>
								<code class="font-mono text-xs text-slate-700 dark:text-slate-300">{ ai.Key }</code>
								<span class="font-medium text-amber-800 dark:text-amber-300">{ ai.Value }</span>
								<span class="text-slate-600 dark:text-slate-400">{ ai.Reason }</span>
								<span class="ml-auto text-xs text-slate-400 dark:text-slate-500">→ { ai.Field }</span>
							</li>
						}
					</ul>
				</div>
			</section>
		}
		if len(missingParents) > 0 {
			<section class="mb-6">
				<h2 class="text-lg font-semibold mb-2 text-rose-700 dark:text-rose-400">
					Missing dependsOn parents ({ fmt.Sprint(len(missingParents)) })
				</h2>
				<div class="bg-white dark:bg-slate-900 rounded border border-rose-200 dark:border-rose-800 p-4">
					<p class="text-sm text-slate-500 dark:text-slate-400 mb-2">
						Monitors reference these slugs in <code class="font-mono">dependsOn</code> but no such monitor exists in the DB. The dependent monitor still runs (the gate is skipped), but the typo silently bypasses the intended pause behavior.
					</p>
					<ul class="text-sm divide-y divide-slate-100 dark:divide-slate-800">
						for _, mp := range missingParents {
							<li class="py-2 flex flex-wrap gap-3">
								<code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{ mp.Parent }</code>
								<span class="text-slate-500 dark:text-slate-400">referenced by</span>
								<span class="font-medium">{ strings.Join(mp.Children, ", ") }</span>
								if !mp.LastSeen.IsZero() {
									<span class="ml-auto text-xs text-slate-400 dark:text-slate-500">
										<span>last seen </span>
										@Timestamp(mp.LastSeen)
									</span>
								}
							</li>
						}
					</ul>
				</div>
			</section>
		}
		if view.IgnoredTotal > 0 {
			<section class="mb-6">
				<h2 class="text-lg font-semibold mb-2 text-slate-600 dark:text-slate-400">
					Skipped ingresses ({ fmt.Sprint(view.IgnoredTotal) })
					<a class="text-sm font-normal ml-2 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100" href="/discovery?status=kube-ignored">View all →</a>
				</h2>
				<div class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4">
					<p class="text-sm text-slate-500 dark:text-slate-400 mb-2">
						Ingresses a matching <code class="font-mono">ignore: true</code> rule deliberately excluded from monitoring. Listed for review, not action — an entry here that you don't recognize means the rule is broader than intended.
					</p>
					<ul class="text-sm divide-y divide-slate-100 dark:divide-slate-800">
						for _, row := range ignoredDiscovery {
							<li class="py-2 flex flex-wrap gap-3">
								<code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{ row.Namespace }</code>
								<a class="font-medium text-blue-700 dark:text-blue-400 hover:underline" href={ templ.SafeURL("/discovery/" + row.Namespace + "/" + row.IngressName + "/" + row.Host) }>{ row.IngressName }</a>
								<span class="text-slate-500 dark:text-slate-400">{ row.Host }</span>
								if row.Reason != nil {
									<span class="text-slate-500 dark:text-slate-400">{ *row.Reason }</span>
								}
							</li>
						}
					</ul>
					if rest := view.IgnoredTotal - len(ignoredDiscovery); rest > 0 {
						<p class="text-xs text-slate-400 dark:text-slate-500 mt-2">
							… and { fmt.Sprint(rest) } more —
							<a class="text-blue-700 dark:text-blue-400 hover:underline" href="/discovery?status=kube-ignored">see the full listing</a>
						</p>
					}
				</div>
			</section>
		}
	}
}

