package templates

import (
	"fmt"
	"strings"
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// alertsFeedCols is the column template for the homepage's latest-alerts
// table: event kind, monitor, code, message, and a right-aligned time.
const alertsFeedCols = "104px 1.5fr 58px 2fr 76px"

// trackedMonitors is the count the Overview eyebrow and its total tile
// report. A monitor is in exactly one of up / down / temporary-paused,
// so those sum; the SSL counts are a separate facet of the same
// monitors and would double-count if added.
func trackedMonitors(s store.HomepageStats) int {
	return s.Up + s.Down + s.TemporaryPaused
}

// StatusPageStats is the per-status-page rollup — same metric
// vocabulary as the global Overview, scoped to the monitors any
// section of the page selects. Computed by the web layer at render
// time. Powers both the /status index tiles and the at-a-glance
// stats row on /status/<slug>.
type StatusPageStats struct {
	Slug            string
	FriendlyName    string
	Description     string
	LogoURL         string
	Color           string // hex
	Total           int
	Up              int
	Down            int
	TemporaryPaused int
	SSLExpiring     int
	SSLExpired      int // presentation-only: ssl-expiring rows whose cert has crossed expires_at
	SSLSkipped      int
}

// pageBadgeKind picks the 3-state badge for a page rollup, mirroring
// status.templ's statusBadgeKind but driven by deduped page totals
// rather than per-section monitor lists.
func pageBadgeKind(s StatusPageStats) string {
	switch {
	case s.Total == 0:
		return "none"
	case s.Down > 0:
		return "down"
	case s.TemporaryPaused > 0 || s.SSLExpiring > 0:
		return "warn"
	default:
		return "up"
	}
}

// firstInitial returns the first letter of s upper-cased, "?" when s
// is empty. Used as the avatar fallback when a status page has no
// logoUrl.
func firstInitial(s string) string {
	for _, r := range s {
		if r == ' ' || r == '\t' {
			continue
		}
		if r >= 'a' && r <= 'z' {
			return string(r - 32)
		}
		return string(r)
	}
	return "?"
}

// avatarColor is the fill for a status page's letter mark. Pages
// without a configured color borrow the indigo accent rather than
// inventing a palette entry.
func avatarColor(color string) string {
	if color == "" {
		return "var(--tm-indigo)"
	}
	return color
}

// statusPageTile renders one status-page card on the /status index:
// letter mark, name, slug, description, then a footer band carrying the
// rollup badge and — only when something is wrong — a problem chip.
templ statusPageTile(s StatusPageStats) {
	{{ kind := pageBadgeKind(s) }}
	<a href={ templ.URL("/status/" + s.Slug) } class="block border border-border rounded-lg overflow-hidden bg-bg transition-colors hover:border-border-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
		<div class="px-4 py-[15px] flex flex-col gap-3">
			<div class="flex items-center gap-2.5">
				if s.LogoURL != "" {
					<img src={ s.LogoURL } alt="" class="w-[30px] h-[30px] rounded-md object-contain shrink-0 bg-surface-muted p-0.5 border border-border"/>
				} else {
					@Avatar(firstInitial(s.FriendlyName), avatarColor(s.Color), 30)
				}
				<div class="min-w-0">
					<div class="text-sm font-bold text-ink leading-tight truncate">{ s.FriendlyName }</div>
					<div class="font-mono text-2xs text-faint truncate">/status/{ s.Slug }</div>
				</div>
			</div>
			<div class="text-xs text-muted leading-snug min-h-[34px] line-clamp-2">
				if s.Description != "" {
					{ s.Description }
				}
			</div>
		</div>
		<div class="px-4 py-[11px] border-t border-hair flex items-center gap-2">
			@Badge(statusTone(kind), statusBadgeLabel(kind))
			<span class="ml-auto flex flex-wrap justify-end gap-1">
				@problemChip("down", s.Down, ToneDown)
				@problemChip("paused", s.TemporaryPaused, ToneWarn)
				@problemChip("ssl exp", s.SSLExpiring, ToneWarn)
				@problemChip("ssl skipped", s.SSLSkipped, ToneNeutral)
				if s.Total > 0 && s.Down == 0 && s.TemporaryPaused == 0 && s.SSLExpiring == 0 {
					<span class="font-mono text-2xs text-faint">all { fmt.Sprint(s.Up) } up</span>
				}
			</span>
		</div>
	</a>
}

// problemChip renders a chip only when count > 0, so a healthy page
// card stays quiet and a degraded one says what's wrong at a glance.
templ problemChip(label string, count int, tone Tone) {
	if count > 0 {
		@Chip(tone) {
			{ fmt.Sprint(count) } { label }
		}
	}
}

// MappingEntry is the per-row payload the homepage renders in the
// "Slack mapping health" panel. Mirrors web.MappingEntry so this
// package doesn't import web (it's imported by web).
type MappingEntry struct {
	Slug    string
	ID      string
	Reason  string
	Checked time.Time
}

// MappingHealth carries the whole panel's state. Empty Invalid →
// quiet panel; non-empty → flagged entries listed.
type MappingHealth struct {
	Invalid []MappingEntry
	LastRun time.Time
}

// AnnotationIssue is one rejected annotation value (ADR-0009). The
// monitor it belongs to is still probing on the cascade value; this is
// a misconfiguration for the app team to fix, not an outage.
type AnnotationIssue struct {
	Slug        string
	Namespace   string
	IngressName string
	Host        string
	Field       string
	Key         string
	Scope       string
	Value       string
	Reason      string
}

// IssuesView bundles every source the /issues page renders. A struct
// rather than positional parameters so a fifth source can't silently
// land in the wrong argument slot.
type IssuesView struct {
	Mapping          MappingHealth
	InvalidDiscovery []store.DiscoverySnapshotRow
	MissingParents   []MissingParent
	Annotations      []AnnotationIssue

	// IgnoredDiscovery is capped at IgnoredPreviewMax rows; IgnoredTotal
	// is the uncapped count. A broad ignore rule (namespace: "test-*")
	// can match hundreds of Ingresses, and the page must not grow with
	// the cluster — /discovery is the place to page through them.
	IgnoredDiscovery []store.DiscoverySnapshotRow
	IgnoredTotal     int
}

// IgnoredPreviewMax is how many kube-ignored rows the /issues page
// lists before deferring to the /discovery link.
const IgnoredPreviewMax = 10

// Total is the issue count the nav badge and the page heading share.
// IgnoredDiscovery is excluded: an operator wrote the ignore: rule that
// produced those rows, so they are an acknowledgement, not an issue.
func (v IssuesView) Total() int {
	return len(v.Mapping.Invalid) + len(v.InvalidDiscovery) +
		len(v.MissingParents) + len(v.Annotations)
}

// MissingParent is one dependsOn reference that didn't resolve to a
// known monitor at lookup time. Surfaced on the /issues page so a
// typo or post-startup drift between config and DB doesn't stay
// buried in app logs.
type MissingParent struct {
	Parent   string
	Children []string
	LastSeen time.Time
}

templ Homepage(stats store.HomepageStats, alerts store.LatestAlertsListing, page, perPage int, mapping MappingHealth) {
	@Layout("Home") {
		{{ tracked := trackedMonitors(stats) }}
		@Eyebrow(fmt.Sprintf("Overview · %d %s", tracked, plural(tracked, "monitor", "monitors")))
		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
			@MetricTileLink(ToneUp, "up", stats.Up, "/monitors?status=up", true)
			@MetricTileLink(ToneDown, "down", stats.Down, "/monitors?status=down", false)
			@MetricTileLink(TonePaused, "paused", stats.TemporaryPaused, "/monitors?status=temporary-paused", false)
			@MetricTileLink(ToneWarn, "ssl exp", stats.SSLExpiring, "/monitors?ssl=ssl-expiring", false)
			@MetricTileLink(ToneArchived, "ssl skipped", stats.SSLSkipped, "/monitors?ssl=ssl-skipped", false)
			@MetricTileLink(ToneNeutral, "total", trackedMonitors(stats), "/monitors", false)
		</div>
		if len(mapping.Invalid) > 0 {
			@Banner(ToneDown) {
				{ fmt.Sprint(len(mapping.Invalid)) } userMapping entr{ plural(len(mapping.Invalid), "y", "ies") } failed validation ·
				<a class="text-accent underline underline-offset-2 hover:text-accent-strong rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/issues">review on /issues</a>
			}
		}
		<div class="flex flex-col gap-3">
			<div class="flex items-baseline justify-between gap-3">
				@SectionHeader("Latest alerts", fmt.Sprintf("%d total", alerts.Total))
				@Link("/monitors") {
					all monitors →
				}
			</div>
			if len(alerts.Items) == 0 {
				@EmptyState("No alerts yet") {
					Every monitor has been healthy since the last restart.
				}
			} else {
				@Table(alertsFeedCols) {
					for _, ev := range alerts.Items {
						@alertFeedRow(ev)
					}
				}
				@Paginator("/", page, perPage, alerts.Total, nil)
			}
		</div>
	}
}

// alertFeedRow is one entry of the homepage feed: what happened, to
// which monitor, with which code, why, and when.
templ alertFeedRow(ev store.AlertEventRow) {
	@TableRow(false, "") {
		@TableCell("") {
			@EventTypeBadge(string(ev.Type))
		}
		@TableCell("") {
			<a class="text-[13px] hover:underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/monitor/" + ev.MonitorSlug) }>
				@MonitorName(ev.FriendlyName)
			</a>
		}
		@TableCell("") {
			if ev.StatusCode != nil && *ev.StatusCode != 0 {
				@HTTPStatusBadge(*ev.StatusCode)
			} else {
				@Dash()
			}
		}
		@TableCell("") {
			if ev.Error != nil && *ev.Error != "" {
				<span class="text-muted line-clamp-2 break-words">{ *ev.Error }</span>
			} else {
				@Dash()
			}
		}
		@TableCell("right") {
			<span class="text-dim whitespace-nowrap" title={ ev.At.UTC().Format(time.RFC3339) }>{ humanDuration(ev.At) }</span>
		}
	}
}

// IssuesPage is the bare-minimum operator-awareness view: anything
// the system noticed at runtime that an operator probably wants to
// look at. It surfaces existing sources — Slack userMapping entries
// that failed the validator, discovery_snapshot rows stuck at
// "kube-invalid", rejected annotation values, and unresolved dependsOn
// parents. None requires new storage; each links out to the page where
// the operator already acts on that class of problem (the homepage
// mapping panel / the /discovery listing).
//
// A trailing "Skipped ingresses" section lists "kube-ignored" rows.
// Those are acknowledgements rather than issues, so they sit below the
// fold and stay out of Total() — but an operator reviewing the page
// needs to see what an ignore: rule swallowed, especially a rule
// written broadly enough to cover more than the wildcard it targeted.
templ IssuesPage(view IssuesView) {
	{{ mapping := view.Mapping }}
	{{ invalidDiscovery := view.InvalidDiscovery }}
	{{ ignoredDiscovery := view.IgnoredDiscovery }}
	{{ missingParents := view.MissingParents }}
	@Layout("Issues") {
		@Eyebrow(fmt.Sprintf("Issues · %d open", view.Total()))
		if view.Total() == 0 {
			@EmptyState("No issues detected") {
				Slack mapping is healthy and no kube ingresses are in an invalid state.
			}
		}
		if len(mapping.Invalid) > 0 {
			@issueSection("Slack mapping", len(mapping.Invalid), ToneDown, "", "") {
				<p class="font-mono text-xs text-muted">
					userMapping entries that failed validation. Fix the IDs in config.yaml or your workspace.
				</p>
				@List("", false) {
					for _, e := range mapping.Invalid {
						<div class="flex flex-wrap gap-3 py-[9px] font-mono text-xs">
							<span class="text-ink w-32">{ e.Slug }</span>
							<span class="text-muted w-32">{ e.ID }</span>
							<span class="text-down">{ e.Reason }</span>
						</div>
					}
				}
				if !mapping.LastRun.IsZero() {
					<p class="font-mono text-2xs text-dim">
						<span>last checked </span>
						@Timestamp(mapping.LastRun)
					</p>
				}
			}
		}
		if len(invalidDiscovery) > 0 {
			@issueSection("Kube-invalid ingresses", len(invalidDiscovery), ToneDown, "/discovery?status=kube-invalid", "view all →") {
				<p class="font-mono text-xs text-muted">
					Ingresses the watcher saw but couldn't materialize into a monitor — a resolved value that failed validation, or a wildcard host no prober can resolve. Fix the value in <span class="text-ink">kube.match</span>; a wildcard host has no value to fix, so acknowledge it with a matching <span class="text-ink">ignore: true</span> rule instead.
				</p>
				@List("", false) {
					for _, row := range invalidDiscovery {
						<div class="flex flex-wrap items-baseline gap-3 py-[9px] font-mono text-xs">
							@Chip(ToneNeutral) {
								{ row.Namespace }
							}
							<span class="text-ink">{ row.IngressName }</span>
							<span class="text-muted">{ row.Host }</span>
							if row.Reason != nil {
								<span class="text-down">{ *row.Reason }</span>
							}
						</div>
					}
				}
			}
		}
		if len(view.Annotations) > 0 {
			@issueSection("Rejected annotation values", len(view.Annotations), ToneWarn, "", "") {
				<p class="font-mono text-xs text-muted">
					Values an app team's chart put in an annotation that toggle-monitor could not use. Each monitor still probes on its cascade value, so this is a misconfiguration to fix — not an outage. Fix the annotation on the Ingress or Namespace.
				</p>
				@List("", false) {
					for _, ai := range view.Annotations {
						<div class="flex flex-wrap items-baseline gap-3 py-[9px] font-mono text-xs">
							@Chip(ToneNeutral) {
								{ ai.Namespace }
							}
							<a class="text-accent hover:text-accent-strong hover:underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.SafeURL("/discovery/" + ai.Namespace + "/" + ai.IngressName + "/" + ai.Host) }>{ ai.IngressName }</a>
							<span class="text-muted">{ ai.Host }</span>
							<span class="text-muted">{ ai.Scope }</span>
							<span class="text-ink">{ ai.Key }</span>
							<span class="text-warn font-semibold">{ ai.Value }</span>
							<span class="text-muted">{ ai.Reason }</span>
							<span class="ml-auto text-dim">→ { ai.Field }</span>
						</div>
					}
				}
			}
		}
		if len(missingParents) > 0 {
			@issueSection("Missing dependsOn parents", len(missingParents), ToneDown, "", "") {
				<p class="font-mono text-xs text-muted">
					Monitors reference these slugs in <span class="text-ink">dependsOn</span> but no such monitor exists in the DB. The dependent monitor still runs (the gate is skipped), but the typo silently bypasses the intended pause behavior.
				</p>
				@List("", false) {
					for _, mp := range missingParents {
						<div class="flex flex-wrap items-baseline gap-3 py-[9px] font-mono text-xs">
							@Chip(ToneNeutral) {
								{ mp.Parent }
							}
							<span class="text-muted">referenced by</span>
							<span class="text-ink">{ strings.Join(mp.Children, ", ") }</span>
							if !mp.LastSeen.IsZero() {
								<span class="ml-auto text-dim">
									<span>last seen </span>
									@Timestamp(mp.LastSeen)
								</span>
							}
						</div>
					}
				}
			}
		}
		if view.IgnoredTotal > 0 {
			@issueSection("Skipped ingresses", view.IgnoredTotal, ToneArchived, "/discovery?status=kube-ignored", "view all →") {
				<p class="font-mono text-xs text-muted">
					Ingresses a matching <span class="text-ink">ignore: true</span> rule deliberately excluded from monitoring. Listed for review, not action — an entry here that you don't recognize means the rule is broader than intended.
				</p>
				@List("", false) {
					for _, row := range ignoredDiscovery {
						<div class="flex flex-wrap items-baseline gap-3 py-[9px] font-mono text-xs">
							@Chip(ToneNeutral) {
								{ row.Namespace }
							}
							<a class="text-accent hover:text-accent-strong hover:underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.SafeURL("/discovery/" + row.Namespace + "/" + row.IngressName + "/" + row.Host) }>{ row.IngressName }</a>
							<span class="text-muted">{ row.Host }</span>
							if row.Reason != nil {
								<span class="text-muted">{ *row.Reason }</span>
							}
						</div>
					}
				}
				if rest := view.IgnoredTotal - len(ignoredDiscovery); rest > 0 {
					<p class="font-mono text-2xs text-dim">
						… and { fmt.Sprint(rest) } more —
						<a class="text-accent hover:text-accent-strong underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/discovery?status=kube-ignored">see the full listing</a>
					</p>
				}
			}
		}
	}
}

// issueSection is one block of the /issues page: a titled header with a
// toned count, an optional "view all" link out to the listing that owns
// this class of problem, and the rows themselves.
templ issueSection(title string, count int, tone Tone, href, linkLabel string) {
	<section class="flex flex-col gap-3">
		<div class="flex items-center gap-2.5">
			@SectionHeader(title, "")
			<span data-issue-count={ fmt.Sprint(count) }>
				@Chip(tone) {
					{ fmt.Sprint(count) }
				}
			</span>
			if href != "" {
				<span class="ml-auto">
					@Link(href) {
						{ linkLabel }
					}
				</span>
			}
		</div>
		{ children... }
	</section>
}

// plural picks a suffix for a count, so a banner reads "1 entry" rather
// than "1 entry/entries".
func plural(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}
