package templates

import (
	"strconv"
	"time"
)

// AMAlertsListing renders the /alerts page — filter form, table, paginator.
templ AMAlertsListing(view AMListingView) {
	@Layout("Alerts") {
		<div class="flex items-center gap-3 mb-4">
			<h1 class="text-xl font-semibold">Alerts</h1>
			<span class="text-sm text-slate-500 dark:text-slate-400">Alertmanager-sourced incidents</span>
		</div>
		@amListingFilterForm(view.Filter)
		if len(view.Incidents) == 0 {
			@amListingEmptyState(view)
		} else {
			@amListingTable(view.Incidents)
			@amListingPaginator(view)
		}
	}
}

// amListingFilterForm — same chrome conventions as the discovery
// listing filter form. Plain GET with name= attributes that round-trip
// the query string; the handler swallows unknown values.
templ amListingFilterForm(f AMListingFilter) {
	<form method="get" action="/alerts" class="flex flex-wrap items-end gap-3 mb-4 bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-3">
		<div>
			<label class="block text-xs text-slate-500 dark:text-slate-400 mb-1" for="status">Status</label>
			<select id="status" name="status" class="border border-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 rounded px-2 py-1 text-sm">
				<option value="" selected?={ f.Status == "" }>(any)</option>
				<option value="firing" selected?={ f.Status == "firing" }>firing</option>
				<option value="resolved" selected?={ f.Status == "resolved" }>resolved</option>
			</select>
		</div>
		<div>
			<label class="block text-xs text-slate-500 dark:text-slate-400 mb-1" for="severity">Severity</label>
			<input id="severity" name="severity" value={ f.Severity } class="border border-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 rounded px-2 py-1 text-sm" placeholder="critical / warning / …"/>
		</div>
		<div>
			<label class="block text-xs text-slate-500 dark:text-slate-400 mb-1" for="alertname">Alertname</label>
			<input id="alertname" name="alertname" value={ f.Alertname } class="border border-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 rounded px-2 py-1 text-sm" placeholder="exact match"/>
		</div>
		<div>
			<label class="block text-xs text-slate-500 dark:text-slate-400 mb-1" for="channel">Channel</label>
			<input id="channel" name="channel" value={ f.Channel } class="border border-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 rounded px-2 py-1 text-sm" placeholder="channel slug"/>
		</div>
		<div>
			<label class="block text-xs text-slate-500 dark:text-slate-400 mb-1" for="receiver">Receiver</label>
			<input id="receiver" name="receiver" value={ f.Receiver } class="border border-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 rounded px-2 py-1 text-sm" placeholder="receiver name"/>
		</div>
		<div>
			<label class="block text-xs text-slate-500 dark:text-slate-400 mb-1" for="from">From</label>
			<input id="from" name="from" type="datetime-local" value={ f.From } class="border border-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 rounded px-2 py-1 text-sm"/>
		</div>
		<div>
			<label class="block text-xs text-slate-500 dark:text-slate-400 mb-1" for="to">To</label>
			<input id="to" name="to" type="datetime-local" value={ f.To } class="border border-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 rounded px-2 py-1 text-sm"/>
		</div>
		<button class="bg-slate-900 dark:bg-slate-200 dark:text-slate-900 text-white text-sm px-3 py-1.5 rounded">Apply</button>
		if !f.IsEmpty() {
			<a class="text-sm text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100" href="/alerts">Clear filters</a>
		}
	</form>
}

// amListingEmptyState — distinguishes "no AM alerts have ever fired"
// from "filters narrowed to zero". Mirrors the discovery listing's
// empty-state pattern.
templ amListingEmptyState(view AMListingView) {
	if view.Empty {
		<div class="rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 text-sm">
			<p class="font-medium text-slate-700 dark:text-slate-200 mb-1">No AM alerts have ever fired.</p>
			<p class="text-slate-500 dark:text-slate-400">As soon as Alertmanager posts to <code class="text-xs">/webhooks/alertmanager</code>, incidents will appear here.</p>
		</div>
	} else {
		<div class="rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 text-sm">
			<p class="text-slate-600 dark:text-slate-400">No alerts match your filters. <a class="text-blue-700 dark:text-blue-400 hover:underline" href="/alerts">Clear filters</a>.</p>
		</div>
	}
}

// amListingTable is the main table — columns from the spec: Started ↓,
// Alertname, Severity, Labels chips, Channel, Status, Duration.
templ amListingTable(rows []AMIncidentRow) {
	<table class="w-full bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 overflow-hidden">
		<thead>
			<tr class="bg-slate-50 dark:bg-slate-800 text-left text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
				<th class="py-2 px-3">Started ↓</th>
				<th class="py-2 px-3">Alertname</th>
				<th class="py-2 px-3">Severity</th>
				<th class="py-2 px-3">Labels</th>
				<th class="py-2 px-3">Channel</th>
				<th class="py-2 px-3">Status</th>
				<th class="py-2 px-3">Duration</th>
			</tr>
		</thead>
		<tbody>
			for _, r := range rows {
				@amListingRow(r)
			}
		</tbody>
	</table>
}

templ amListingRow(r AMIncidentRow) {
	<tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/60 align-top">
		<td class="py-2 px-3 text-sm whitespace-nowrap text-slate-500 dark:text-slate-400">
			<span title={ r.StartedAt.UTC().Format(time.RFC3339) }>{ r.StartedAt.UTC().Format("2006-01-02 15:04") }</span>
		</td>
		<td class="py-2 px-3 text-sm">
			<a class="text-blue-700 dark:text-blue-400 hover:underline" href={ templ.URL("/alert/" + strconv.FormatInt(r.ID, 10)) }>{ r.Alertname }</a>
		</td>
		<td class="py-2 px-3 text-sm">
			if r.Severity != "" {
				@AMSeverityChip(r.Severity)
			} else {
				<span class="text-slate-400 dark:text-slate-600">—</span>
			}
		</td>
		<td class="py-2 px-3 text-sm">
			if len(r.KeyLabels) == 0 {
				<span class="text-slate-400 dark:text-slate-600">—</span>
			} else {
				<div class="flex flex-wrap gap-1">
					for _, kv := range r.KeyLabels {
						<code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{ kv.Key }: { kv.Value }</code>
					}
				</div>
			}
		</td>
		<td class="py-2 px-3 text-sm">
			if r.ChannelSlug == "" {
				<span class="text-slate-400 dark:text-slate-600">—</span>
			} else {
				<code class="font-mono text-xs">{ r.ChannelSlug }</code>
			}
		</td>
		<td class="py-2 px-3 text-sm">@AMStatusChip(r.Status)</td>
		<td class="py-2 px-3 text-sm text-slate-500 dark:text-slate-400 whitespace-nowrap">
			{ amRowDurationText(r) }
		</td>
	</tr>
}

// AMSeverityChip renders the severity label with severity-specific
// tint. Used by the listing row and the detail page header.
templ AMSeverityChip(severity string) {
	<span class={ "inline-block px-2 py-0.5 rounded text-xs font-medium", severityBadgeClasses(severity) }>{ severity }</span>
}

// AMStatusChip renders the firing/resolved chip on the listing row.
templ AMStatusChip(status string) {
	<span class={ "inline-block px-2 py-0.5 rounded text-xs font-medium", amStatusBadgeClasses(status) }>{ status }</span>
}

// amListingPaginator is a prev/next link pair with per-page indicator.
// We don't have a precomputed total, so HasNext drives visibility.
templ amListingPaginator(view AMListingView) {
	<div class="mt-4 flex items-center gap-3 text-sm text-slate-600 dark:text-slate-400">
		if view.Page > 1 {
			<a class="text-blue-700 dark:text-blue-400 hover:underline" href={ templ.SafeURL(AMListingURL(view.Filter, view.Page-1, view.PerPage)) }>← Previous</a>
		}
		<span>Page { strconv.Itoa(view.Page) }</span>
		if view.HasNext {
			<a class="text-blue-700 dark:text-blue-400 hover:underline" href={ templ.SafeURL(AMListingURL(view.Filter, view.Page+1, view.PerPage)) }>Next →</a>
		}
	</div>
}

// AMAlertDetail renders /alert/{id}. Mirrors the layout sketched in
// ADR-0005 §UI: header chips, status panel, summary, description,
// runbook, labels, routing, slack, history, raw payload.
templ AMAlertDetail(view AMDetailView) {
	{{ inc := view.Incident }}
	@Layout("Alert — "+inc.Alertname) {
		<div class="flex items-center gap-3 mb-4 flex-wrap">
			<h1 class="text-xl font-semibold inline-flex items-center gap-2">
				<span aria-hidden="true">@amSeverityEmoji(inc.Severity)</span>
				<span>{ inc.Alertname }</span>
			</h1>
			if inc.Severity != "" {
				@AMSeverityChip(inc.Severity)
			}
			@AMStatusChip(inc.Status)
			<span class="text-xs text-slate-500 dark:text-slate-400 font-mono break-all">fingerprint: { inc.Fingerprint }</span>
		</div>

		@amDetailStatusPanel(inc)
		@amDetailSummaryPanel(inc)
		@amDetailLabelsPanel(inc)
		@amDetailRoutingPanel(inc)
		@amDetailSlackPanel(inc)
		@amDetailHistorySection(view.History, inc.ID)
		@amDetailRawPayloadSection(view.RawPayload)
	}
}

templ amDetailStatusPanel(inc AMIncidentDetail) {
	<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4 mb-6">
		<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Status</h2>
		<dl>
			@kvTime("Started", inc.StartedAt)
			<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
				<dt class="text-sm text-slate-500 dark:text-slate-400">Status</dt>
				<dd class="text-sm col-span-2">
					<span class={ "inline-block px-2 py-0.5 rounded text-xs font-medium", amStatusBadgeClasses(inc.Status) }>{ amStatusLabel(inc.Status) }</span>
					<span class="text-slate-500 dark:text-slate-400 ml-2">{ amDurationLabel(inc) }</span>
				</dd>
			</div>
			if inc.EndedAt != nil {
				@kvTime("Resolved", *inc.EndedAt)
			}
			if inc.Receiver != "" {
				@kv("Receiver", inc.Receiver)
			}
			if inc.ExternalURL != "" {
				<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
					<dt class="text-sm text-slate-500 dark:text-slate-400">Via</dt>
					<dd class="text-sm col-span-2 break-all">
						<a class="text-blue-700 dark:text-blue-400 hover:underline" href={ templ.URL(inc.ExternalURL) } target="_blank" rel="noopener noreferrer">{ inc.ExternalHost() }</a>
					</dd>
				</div>
			}
		</dl>
	</section>
}

templ amDetailSummaryPanel(inc AMIncidentDetail) {
	{{ summary := inc.AnnotationByKey("summary") }}
	{{ description := inc.AnnotationByKey("description") }}
	{{ runbook := inc.AnnotationByKey("runbook_url") }}
	<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4 mb-6">
		<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Summary</h2>
		if summary != "" {
			<p class="text-sm text-slate-900 dark:text-slate-100 mb-3">{ summary }</p>
		} else {
			<p class="text-sm text-slate-500 dark:text-slate-400 italic mb-3">No summary.</p>
		}
		if description != "" {
			<h3 class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-1">Description</h3>
			<p class="text-sm text-slate-700 dark:text-slate-300 whitespace-pre-wrap mb-3">{ description }</p>
		}
		if runbook != "" {
			<p class="text-sm">
				<a class="text-blue-700 dark:text-blue-400 hover:underline break-all" href={ templ.URL(runbook) } target="_blank" rel="noopener noreferrer">Runbook: { runbook }</a>
			</p>
		}
	</section>
}

templ amDetailLabelsPanel(inc AMIncidentDetail) {
	if len(inc.Labels) > 0 {
		<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4 mb-6">
			<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Labels</h2>
			<dl>
				for _, kv := range inc.Labels {
					<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
						<dt class="text-sm font-mono text-slate-500 dark:text-slate-400 break-all">{ kv.Key }</dt>
						<dd class="text-sm text-slate-900 dark:text-slate-100 col-span-2 break-words font-mono">{ kv.Value }</dd>
					</div>
				}
			</dl>
		</section>
	}
}

templ amDetailRoutingPanel(inc AMIncidentDetail) {
	<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4 mb-6">
		<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Routing</h2>
		<dl>
			if inc.RuleChain != "" {
				@kv("Matched rules", inc.RuleChain)
			}
			@kv("Channel", inc.ChannelSlug)
			if len(inc.ResolvedNotify) > 0 {
				<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
					<dt class="text-sm text-slate-500 dark:text-slate-400">Notify</dt>
					<dd class="text-sm col-span-2 flex flex-wrap gap-1.5">
						for _, n := range inc.ResolvedNotify {
							<code class="font-mono text-xs px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{ n }</code>
						}
					</dd>
				</div>
			}
		</dl>
	</section>
}

templ amDetailSlackPanel(inc AMIncidentDetail) {
	if inc.SlackChannel != "" || inc.SlackTS != "" {
		<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4 mb-6">
			<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Slack</h2>
			<dl>
				if inc.SlackChannel != "" {
					@kv("Channel ID", inc.SlackChannel)
				}
				if inc.SlackTS != "" {
					@kv("Message TS", inc.SlackTS)
				}
				if inc.SlackPermalink != "" {
					<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
						<dt class="text-sm text-slate-500 dark:text-slate-400">Permalink</dt>
						<dd class="text-sm col-span-2 break-all">
							<a class="text-blue-700 dark:text-blue-400 hover:underline" href={ templ.URL(inc.SlackPermalink) } target="_blank" rel="noopener noreferrer">Open in Slack</a>
						</dd>
					</div>
				}
			</dl>
		</section>
	}
}

templ amDetailHistorySection(history []AMIncidentRow, currentID int64) {
	<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4 mb-6">
		<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Fingerprint history</h2>
		if len(history) == 0 {
			<p class="text-sm text-slate-500 dark:text-slate-400 italic">No prior incidents for this fingerprint.</p>
		} else {
			<ul class="divide-y divide-slate-100 dark:divide-slate-800">
				for _, r := range history {
					if r.ID != currentID {
						<li class="py-2 text-sm flex flex-wrap items-center gap-3">
							<a class="text-blue-700 dark:text-blue-400 hover:underline font-mono text-xs" href={ templ.URL("/alert/" + strconv.FormatInt(r.ID, 10)) }>#{ strconv.FormatInt(r.ID, 10) }</a>
							@AMStatusChip(r.Status)
							<span title={ r.StartedAt.UTC().Format(time.RFC3339) } class="text-slate-500 dark:text-slate-400">{ r.StartedAt.UTC().Format("2006-01-02 15:04") }</span>
							<span class="text-slate-500 dark:text-slate-400">{ amRowDurationText(r) }</span>
						</li>
					}
				}
			</ul>
		}
	</section>
}

templ amDetailRawPayloadSection(payload string) {
	<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4 mb-6">
		<details>
			<summary class="cursor-pointer text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 select-none">Raw payload <span class="text-xs text-slate-400 normal-case">(click to expand)</span></summary>
			if payload == "" {
				<p class="mt-3 text-sm text-slate-500 dark:text-slate-400 italic">No webhook event recorded for this incident yet.</p>
			} else {
				<pre class="mt-3 bg-slate-50 dark:bg-slate-950 rounded p-3 overflow-auto text-xs"><code>{ payload }</code></pre>
			}
		</details>
	</section>
}

// amSeverityEmoji surfaces the severity hint the Slack header uses, so
// the operator who landed via "View details" sees a matching visual.
templ amSeverityEmoji(severity string) {
	switch severity {
		case "critical", "page":
			<span>🚨</span>
		case "warning", "warn":
			<span>⚠️</span>
		case "info":
			<span>ℹ️</span>
		default:
			<span>🔔</span>
	}
}
