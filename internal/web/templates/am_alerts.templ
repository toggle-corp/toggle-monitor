package templates

import (
	"strconv"
	"time"
)

// amListingCols is the /alerts column template: started, alertname,
// severity, key labels, channel, status, duration.
const amListingCols = "130px 1.3fr .7fr 1.6fr .8fr .7fr .7fr"

// AMAlertsListing renders the /alerts page — filter form, table, paginator.
templ AMAlertsListing(view AMListingView) {
	@Layout("Alerts") {
		@Eyebrow("Alerts · Alertmanager-sourced incidents")
		@amListingFilterForm(view.Filter)
		if len(view.Incidents) == 0 {
			@amListingEmptyState(view)
		} else {
			<div class="overflow-x-auto">
				@amListingTable(view.Incidents)
			</div>
			@amListingPaginator(view)
		}
	}
}

// amListingFilterForm — same chrome conventions as the discovery
// listing filter form. Plain GET with name= attributes that round-trip
// the query string; the handler swallows unknown values.
templ amListingFilterForm(f AMListingFilter) {
	<form method="get" action="/alerts">
		@Toolbar() {
			@SelectField("status", "Status") {
				<option value="" selected?={ f.Status == "" }>status: any</option>
				<option value="firing" selected?={ f.Status == "firing" }>firing</option>
				<option value="resolved" selected?={ f.Status == "resolved" }>resolved</option>
			}
			<div class="min-w-[150px]">
				@SearchField("severity", "severity", f.Severity)
			</div>
			<div class="flex-1 min-w-[170px]">
				@SearchField("alertname", "alertname — exact", f.Alertname)
			</div>
			<div class="min-w-[150px]">
				@SearchField("channel", "channel slug", f.Channel)
			</div>
			<div class="min-w-[150px]">
				@SearchField("receiver", "receiver", f.Receiver)
			</div>
			@amDateField("from", "From", f.From)
			@amDateField("to", "To", f.To)
			@Button("primary", "submit") {
				apply
			}
			if !f.IsEmpty() {
				@LinkButton("ghost", "/alerts") {
					clear
				}
			}
		}
	</form>
}

// amDateField is a native datetime-local input in the design's
// clothing. The visible label sits inside the control because a
// bare datetime picker gives no hint which end of the range it is.
templ amDateField(name, label, value string) {
	<label class="inline-flex items-center gap-2 border border-border rounded-md px-3 py-[7px] min-h-[34px] font-mono text-[12.5px] focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-accent">
		<span class="text-faint">{ label }</span>
		<input
			id={ name }
			name={ name }
			type="datetime-local"
			value={ value }
			class="border-0 bg-transparent outline-none text-ink font-mono text-[12.5px]"
		/>
	</label>
}

// amListingEmptyState — distinguishes "no AM alerts have ever fired"
// from "filters narrowed to zero". Mirrors the discovery listing's
// empty-state pattern.
templ amListingEmptyState(view AMListingView) {
	if view.Empty {
		@EmptyState("No AM alerts have ever fired") {
			As soon as Alertmanager posts to <span class="text-ink">/webhooks/alertmanager</span>, incidents will appear here.
		}
	} else {
		@EmptyState("No alerts match your filters") {
			<a class="text-accent underline underline-offset-2 hover:text-accent-strong rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/alerts">clear filters</a>
		}
	}
}

// amListingTable is the main table — columns from the spec: Started ↓,
// Alertname, Severity, Labels chips, Channel, Status, Duration.
templ amListingTable(rows []AMIncidentRow) {
	@Table(amListingCols) {
		@TableRow(true, "") {
			@TableHeadCell("descending") {
				started ↓
			}
			@TableHeadCell("") {
				alertname
			}
			@TableHeadCell("") {
				severity
			}
			@TableHeadCell("") {
				labels
			}
			@TableHeadCell("") {
				channel
			}
			@TableHeadCell("") {
				status
			}
			@TableHeadCell("") {
				duration
			}
		}
		for _, r := range rows {
			@amListingRow(r)
		}
	}
}

templ amListingRow(r AMIncidentRow) {
	@TableRow(false, AMStatusTone(r.Status)) {
		@TableCell("") {
			<span class="text-muted whitespace-nowrap" title={ r.StartedAt.UTC().Format(time.RFC3339) }>{ r.StartedAt.UTC().Format("2006-01-02 15:04") }</span>
		}
		@TableCell("") {
			<a class="text-accent hover:text-accent-strong hover:underline underline-offset-2 break-words rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/alert/" + strconv.FormatInt(r.ID, 10)) }>{ r.Alertname }</a>
		}
		@TableCell("") {
			if r.Severity != "" {
				@AMSeverityChip(r.Severity)
			} else {
				@Dash()
			}
		}
		@TableCell("") {
			if len(r.KeyLabels) == 0 {
				@Dash()
			} else {
				<span class="flex flex-wrap gap-1">
					for _, kv := range r.KeyLabels {
						@Chip(ToneNeutral) {
							{ kv.Key }: { kv.Value }
						}
					}
				</span>
			}
		}
		@TableCell("") {
			if r.ChannelSlug == "" {
				@Dash()
			} else {
				<span class="text-muted break-all">{ r.ChannelSlug }</span>
			}
		}
		@TableCell("") {
			@AMStatusChip(r.Status)
		}
		@TableCell("") {
			<span class="text-muted whitespace-nowrap">{ amRowDurationText(r) }</span>
		}
	}
}

// AMSeverityChip renders the severity label with its severity tone.
// Used by the listing row and the detail page header.
templ AMSeverityChip(severity string) {
	@Chip(AMSeverityTone(severity)) {
		{ severity }
	}
}

// AMStatusChip renders the firing/resolved state. It is a full badge
// rather than a chip: this is the row's status, and the status
// vocabulary always carries a mark plus a label.
templ AMStatusChip(status string) {
	@Badge(AMStatusTone(status), status)
}

// amListingPaginator is a prev/next link pair with per-page indicator.
// We don't have a precomputed total, so HasNext drives visibility.
templ amListingPaginator(view AMListingView) {
	<nav aria-label="Pagination" class="flex items-center justify-between font-mono text-xs text-muted">
		<span>page { strconv.Itoa(view.Page) }</span>
		<span class="flex gap-2">
			if view.Page > 1 {
				@paginatorStep(templ.SafeURL(AMListingURL(view.Filter, view.Page-1, view.PerPage)), "prev")
			}
			if view.HasNext {
				@paginatorStep(templ.SafeURL(AMListingURL(view.Filter, view.Page+1, view.PerPage)), "next")
			}
		</span>
	</nav>
}

// AMAlertDetail renders /alert/{id}. Mirrors the layout sketched in
// ADR-0005 §UI: header chips, status panel, summary, description,
// runbook, labels, routing, slack, history, raw payload.
templ AMAlertDetail(view AMDetailView) {
	{{ inc := view.Incident }}
	@Layout("Alert — "+inc.Alertname) {
		@Breadcrumb([]Crumb{{Label: "Alerts", Href: "/alerts"}, {Label: inc.Alertname}})
		<div class="flex flex-wrap items-center gap-3.5">
			@PageTitle(true) {
				<span aria-hidden="true">
					@amSeverityEmoji(inc.Severity)
				</span>
				<span>{ inc.Alertname }</span>
			}
			if inc.Severity != "" {
				@AMSeverityChip(inc.Severity)
			}
			@AMStatusChip(inc.Status)
			<span class="font-mono text-2xs text-faint break-all">fingerprint: { inc.Fingerprint }</span>
		</div>
		<div class="grid grid-cols-1 lg:grid-cols-[1.45fr_1fr] gap-4 items-start">
			<div class="flex flex-col gap-4 min-w-0">
				@amDetailStatusPanel(inc)
				@amDetailSummaryPanel(inc)
				@amDetailLabelsPanel(inc)
			</div>
			<div class="flex flex-col gap-4 min-w-0">
				@amDetailRoutingPanel(inc)
				@amDetailSlackPanel(inc)
				@amDetailHistorySection(view.History, inc.ID)
			</div>
		</div>
		@amDetailRawPayloadSection(view.RawPayload)
	}
}

templ amDetailStatusPanel(inc AMIncidentDetail) {
	@List("Status", false) {
		@kvTime("started", inc.StartedAt)
		@KeyValue("status", kvKeyWidth) {
			@Badge(AMStatusTone(inc.Status), amStatusLabel(inc.Status))
			<span class="text-muted ml-2">{ amDurationLabel(inc) }</span>
		}
		if inc.EndedAt != nil {
			@kvTime("resolved", *inc.EndedAt)
		}
		if inc.Receiver != "" {
			@kv("receiver", inc.Receiver)
		}
		if inc.ExternalURL != "" {
			@KeyValue("via", kvKeyWidth) {
				@ExternalLink(inc.ExternalURL, "Open "+inc.ExternalURL) {
					<span class="break-all">{ inc.ExternalHost() }</span>
				}
			}
		}
	}
}

templ amDetailSummaryPanel(inc AMIncidentDetail) {
	{{ summary := inc.AnnotationByKey("summary") }}
	{{ description := inc.AnnotationByKey("description") }}
	{{ runbook := inc.AnnotationByKey("runbook_url") }}
	@Card("Summary") {
		<div class="p-4 flex flex-col gap-3">
			if summary != "" {
				<p class="text-xs text-ink">{ summary }</p>
			} else {
				<p class="font-mono text-xs text-faint">No summary.</p>
			}
			if description != "" {
				<div>
					<div class="font-mono text-2xs tracking-[.06em] uppercase text-faint mb-1">Description</div>
					<p class="text-xs text-muted whitespace-pre-wrap">{ description }</p>
				</div>
			}
			if runbook != "" {
				@ExternalLink(runbook, "Open runbook") {
					<span class="break-all">Runbook: { runbook }</span>
				}
			}
		</div>
	}
}

templ amDetailLabelsPanel(inc AMIncidentDetail) {
	if len(inc.Labels) > 0 {
		@List("Labels", false) {
			for _, kv := range inc.Labels {
				@KeyValue(kv.Key, kvKeyWidth) {
					{ kv.Value }
				}
			}
		}
	}
}

templ amDetailRoutingPanel(inc AMIncidentDetail) {
	@List("Routing", false) {
		if inc.RuleChain != "" {
			@kv("matched rules", inc.RuleChain)
		}
		@kv("channel", inc.ChannelSlug)
		if len(inc.ResolvedNotify) > 0 {
			@KeyValue("notify", kvKeyWidth) {
				@Cluster() {
					for _, n := range inc.ResolvedNotify {
						@Chip(ToneNeutral) {
							{ n }
						}
					}
				}
			}
		}
	}
}

templ amDetailSlackPanel(inc AMIncidentDetail) {
	if inc.SlackChannel != "" || inc.SlackTS != "" {
		@List("Slack", false) {
			if inc.SlackChannel != "" {
				@kv("channel id", inc.SlackChannel)
			}
			if inc.SlackTS != "" {
				@kv("message ts", inc.SlackTS)
			}
			if inc.SlackPermalink != "" {
				@KeyValue("permalink", kvKeyWidth) {
					@ExternalLink(inc.SlackPermalink, "Open in Slack") {
						Open in Slack
					}
				}
			}
		}
	}
}

templ amDetailHistorySection(history []AMIncidentRow, currentID int64) {
	@List("Fingerprint history", false) {
		if len(history) == 0 {
			<div class="py-[11px] font-mono text-xs text-faint">No prior incidents for this fingerprint.</div>
		} else {
			for _, r := range history {
				if r.ID != currentID {
					<div class="py-[11px] flex flex-wrap items-center gap-3 font-mono text-xs">
						<a class="text-accent hover:text-accent-strong underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/alert/" + strconv.FormatInt(r.ID, 10)) }>#{ strconv.FormatInt(r.ID, 10) }</a>
						@AMStatusChip(r.Status)
						<span title={ r.StartedAt.UTC().Format(time.RFC3339) } class="text-muted">{ r.StartedAt.UTC().Format("2006-01-02 15:04") }</span>
						<span class="ml-auto text-dim">{ amRowDurationText(r) }</span>
					</div>
				}
			}
		}
	}
}

templ amDetailRawPayloadSection(payload string) {
	<details class="border border-border rounded-lg overflow-hidden bg-bg">
		<summary class="cursor-pointer select-none px-[14px] py-[9px] font-mono text-2xs tracking-[.06em] uppercase text-faint hover:text-ink">
			Raw payload <span class="text-dim">(click to expand)</span>
		</summary>
		<div class="p-4 border-t border-border">
			if payload == "" {
				<p class="font-mono text-xs text-faint">No webhook event recorded for this incident yet.</p>
			} else {
				@Code() {
					{ payload }
				}
			}
		</div>
	</details>
}

// amSeverityEmoji surfaces the severity hint the Slack header uses, so
// the operator who landed via "View details" sees a matching visual.
templ amSeverityEmoji(severity string) {
	switch severity {
		case "critical", "page":
			<span>🚨</span>
		case "warning", "warn":
			<span>⚠️</span>
		case "info":
			<span>ℹ️</span>
		default:
			<span>🔔</span>
	}
}
