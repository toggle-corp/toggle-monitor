package templates

import (
	"fmt"
	"strconv"
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// MonitorConfig is the display-side mirror of scheduler.Plan — every
// field the operator wants to see for a monitor that isn't part of
// the runtime "current state" panel. Lifecycle constructs one of these
// per-monitor by reading the live PlanSource so static + kube monitors
// render identically.
type MonitorConfig struct {
	Preset                 string
	HTTPMethod             string
	AcceptedStatusCodes    []int
	Interval               time.Duration
	Timeout                time.Duration
	Retries                int
	RetryBackoff           time.Duration
	FollowRedirects        bool
	TLSInsecureSkipVerify  bool
	Proxy                  string
	UserAgent              string
	ReminderInterval       time.Duration
	SlackChannelSlug       string
	Mentions               []MentionDisplay
	IsHTTPS                bool
	SSLAlertThreshold      time.Duration
	SSLEscalationThreshold time.Duration
	SSLReminderInterval    time.Duration
}

// MentionDisplay carries enough about a resolved Slack mention to
// render it as "<slug> <code>U…</code>" in the config dialog. For
// raw special markers (<!here>, <!channel>) the slug and ID are
// empty and Raw carries the verbatim marker.
type MentionDisplay struct {
	Slug string // reverse-resolved from userMapping; empty if unknown
	ID   string // U… for users, S… for subteams; empty for raw markers
	Raw  string // <!here>, <!channel>, etc.; empty for slug-backed mentions
}

// kvKeyWidth is the label column for the detail page's state panel;
// kvWideKeyWidth is the config dialog's, whose labels run longer
// ("SSL escalation threshold").
const (
	kvKeyWidth     = 140
	kvWideKeyWidth = 190
)

templ kv(label, value string) {
	@KeyValue(label, kvKeyWidth) {
		{ value }
	}
}

// kvWide is kv with the config dialog's label column.
templ kvWide(label, value string) {
	@KeyValue(label, kvWideKeyWidth) {
		{ value }
	}
}

// kvTime is the same row shape as kv but the value is an
// RFC3339 + (Xago) Timestamp instead of a plain string.
templ kvTime(label string, t time.Time) {
	@KeyValue(label, kvKeyWidth) {
		@Timestamp(t)
	}
}

// kvHTTPCode is the same row shape as kv but renders an HTTP status
// code as a toned chip.
templ kvHTTPCode(label string, code int) {
	@KeyValue(label, kvKeyWidth) {
		@HTTPStatusBadge(code)
	}
}

// kvHTTPCodes is the multi-code variant of kvHTTPCode: each accepted
// status code renders as its own chip so the dialog matches the "Last
// status code" treatment on the detail page.
templ kvHTTPCodes(label string, codes []int) {
	@KeyValue(label, kvWideKeyWidth) {
		@Cluster() {
			for _, c := range codes {
				@HTTPStatusBadge(c)
			}
		}
	}
}

// kvTags renders the monitor's tag set as a cluster of chips. Empty
// list renders nothing — callers wrap in if len(m.Tags) > 0.
templ kvTags(label string, tags []string, keyWidth int) {
	@KeyValue(label, keyWidth) {
		@Cluster() {
			for _, t := range tags {
				@TagChip(t)
			}
		}
	}
}

// AppearsOnEntry is one chip in the monitor detail page's "Appears
// on" section: a label + slug + URL to the status page the monitor
// matched. Computed by the web layer by evaluating each status page's
// match tree against the monitor's tag set + host.
type AppearsOnEntry struct {
	FriendlyName string
	Slug         string
	Color        string // hex, empty for no accent
}

// kvAppearsOn renders the "Appears on" backlink list — a row of chips
// linking to /status/<slug>, capped at 5 with "+N more" overflow. See
// ADR-0003 §"Web layer / Monitor detail".
templ kvAppearsOn(label string, entries []AppearsOnEntry) {
	@KeyValue(label, kvKeyWidth) {
		@Cluster() {
			{{ shown := entries }}
			{{ overflow := 0 }}
			if len(entries) > 5 {
				{{ shown = entries[:5] }}
				{{ overflow = len(entries) - 5 }}
			}
			for _, e := range shown {
				<a class="inline-flex items-center gap-1.5 border border-border rounded px-[7px] py-px text-2xs font-semibold text-accent hover:bg-surface-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/status/" + e.Slug) }>
					if e.Color != "" {
						<span class="inline-block w-2 h-2 rounded-full shrink-0" style={ "background-color: " + e.Color }></span>
					}
					{ e.FriendlyName }
				</a>
			}
			if overflow > 0 {
				<span class="text-2xs text-faint">+{ fmt.Sprint(overflow) } more</span>
			}
		}
	}
}

// kvSlugLinks renders a list of monitor slugs as links to each
// monitor's detail page. Used by "Depends on" and the gating-parents
// row so the operator can hop straight to the upstream monitor that's
// pausing or being depended on.
templ kvSlugLinks(label string, slugs []string, keyWidth int) {
	@KeyValue(label, keyWidth) {
		@Cluster() {
			for _, s := range slugs {
				<a class="text-accent hover:text-accent-strong underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/monitor/" + s) }>{ s }</a>
			}
		}
	}
}

// kvMentions renders each mention as "<slug> <id>" so the operator can
// map a Slack ID back to the configured slug without hunting through
// userMapping. Raw markers (<!here>, <!channel>) render as a bare chip
// — no slug to show.
templ kvMentions(label string, mentions []MentionDisplay) {
	@KeyValue(label, kvWideKeyWidth) {
		@Cluster() {
			for _, m := range mentions {
				<span class="inline-flex items-center gap-1.5">
					if m.Raw != "" {
						@Chip(ToneNeutral) {
							{ m.Raw }
						}
					} else {
						if m.Slug != "" {
							<span>{ m.Slug }</span>
						}
						@Chip(ToneNeutral) {
							{ m.ID }
						}
					}
				</span>
			}
		}
	}
}

// kvSSL renders the SSL status through the same short-label treatment
// the listings use, so "ssl-expiring" reads as "expiring" (or
// "expired") here too rather than as its raw persisted value.
templ kvSSL(label, status string, expiresAt *time.Time) {
	@KeyValue(label, kvKeyWidth) {
		@SSLCell(status, expiresAt)
	}
}

// kvURL renders the value as a clickable external link, opening in a
// new tab so the operator's monitor-detail tab stays put.
templ kvURL(label, href string, keyWidth int) {
	@KeyValue(label, keyWidth) {
		@ExternalLink(href, "Open "+href) {
			<span class="break-all">{ href }</span>
		}
	}
}

// archivedBanner is the warning rendered between the title row and the
// "Last known state" panel for soft-deleted monitors. The reason line
// is omitted when archive_reason is nil or empty so legacy rows don't
// display a "Reason: " stub.
templ archivedBanner(m store.MonitorRow) {
	@Banner(ToneWarn) {
		<span class="text-ink font-semibold">This monitor has been archived.</span>
		if m.ArchiveReason != nil && *m.ArchiveReason != "" {
			<span> { *m.ArchiveReason }</span>
			if m.ArchivedAt != nil {
				<span> — </span>
				@Timestamp(*m.ArchivedAt)
			}
		} else if m.ArchivedAt != nil {
			<span> archived </span>
			@Timestamp(*m.ArchivedAt)
		}
		<span> · The state below reflects its last known values and is no longer updating.</span>
	}
}

// DiscoveredFrom is the (namespace, ingress, host) triple a kube-
// source monitor was materialized from. The monitor detail page
// renders a backlink to /discovery/{ns}/{name}/{host} where the
// cascade trace explains how the monitor's settings were derived.
// nil for static monitors (and for kube monitors whose snapshot row
// has been pruned).
type DiscoveredFrom struct {
	Namespace   string
	IngressName string
	Host        string
}

templ kvDiscoveredFrom(label string, d DiscoveredFrom) {
	@KeyValue(label, kvWideKeyWidth) {
		<a class="text-accent hover:text-accent-strong underline underline-offset-2 break-words rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/discovery/" + d.Namespace + "/" + d.IngressName + "/" + d.Host) }>{ d.Namespace }/{ d.IngressName } · { d.Host }</a>
	}
}

templ MonitorDetail(m store.MonitorRow, cfg *MonitorConfig, gatingParents []string, history []store.AlertEventRow, appearsOn []AppearsOnEntry, discoveredFrom *DiscoveredFrom) {
	{{ layoutTitle := m.FriendlyName }}
	if m.Archived {
		{{ layoutTitle = "[archived] " + m.FriendlyName }}
	}
	@Layout(layoutTitle) {
		@Breadcrumb([]Crumb{{Label: "Monitors", Href: "/monitors"}, {Label: m.Slug}})
		<div class="flex flex-wrap items-center gap-3.5">
			@PageTitle(true) {
				@MonitorName(m.FriendlyName)
			}
			if m.Archived {
				@ArchivedChip()
			} else {
				@StatusBadge(string(m.Status))
			}
			if m.Kind == store.KindSMTP {
				@KindBadge(string(m.Kind))
			}
			if cfg != nil {
				<button type="button" data-config-open class={ "ml-auto", buttonClasses("secondary") }>Show config</button>
			}
		</div>
		if m.Archived {
			@archivedBanner(m)
		} else if m.LastError != nil && *m.LastError != "" {
			@Banner(ToneDown) {
				if m.LastStatusCode != nil && *m.LastStatusCode != 0 {
					<span class="text-ink">{ fmt.Sprint(*m.LastStatusCode) }</span>
					<span> </span>
				}
				{ *m.LastError }
				if m.OpenedAt != nil {
					<span> · opened { humanDuration(*m.OpenedAt) }</span>
				}
			}
		}
		<div class="grid grid-cols-1 lg:grid-cols-[1.45fr_1fr] gap-4 items-start">
			@List(currentStateLabel(m.Archived), false) {
				@kv("slug", m.Slug)
				@kvURL("url", m.URL, kvKeyWidth)
				if m.Kind == store.KindSMTP {
					@kv("tls", m.TLSMode)
				}
				@kv("source", string(m.Source))
				if len(m.Tags) > 0 {
					@kvTags("tags", m.Tags, kvKeyWidth)
				}
				if len(appearsOn) > 0 {
					@kvAppearsOn("appears on", appearsOn)
				}
				if cfg != nil && cfg.Preset != "" {
					@kv("preset", cfg.Preset)
				}
				if len(m.DependsOn) > 0 {
					@kvSlugLinks("depends on", m.DependsOn, kvKeyWidth)
				}
				if string(m.Status) == "temporary-paused" && len(gatingParents) > 0 {
					@kvSlugLinks("gated by (down)", gatingParents, kvKeyWidth)
				}
				if m.LastCheckedAt != nil {
					@kvTime("last checked", *m.LastCheckedAt)
				}
				if m.LastStatusCode != nil {
					@kvHTTPCode("last code", *m.LastStatusCode)
				}
				if m.LastError != nil && *m.LastError != "" {
					@KeyValue("last error", kvKeyWidth) {
						<span class="text-down">{ *m.LastError }</span>
					}
				}
				if m.OpenedAt != nil {
					@kvTime("opened at", *m.OpenedAt)
				}
				if m.SSLStatus != nil {
					@kvSSL("ssl", string(*m.SSLStatus), m.SSLExpiresAt)
				}
				if m.SSLExpiresAt != nil {
					@kvTime("ssl expires", *m.SSLExpiresAt)
				}
				if m.SSLIssuer != nil && *m.SSLIssuer != "" {
					@kv("ssl issuer", *m.SSLIssuer)
				}
			}
			@List("Alert history", false) {
				if len(history) == 0 {
					<div class="py-[11px] font-mono text-xs text-faint">No alert history yet.</div>
				} else {
					for _, ev := range history {
						@historyEntry(ev)
					}
				}
			}
		</div>
		if cfg != nil {
			@configDialog(m, *cfg, discoveredFrom)
			@showConfigDialog()
		}
	}
}

// currentStateLabel names the state panel. An archived monitor's values
// are frozen, and the heading is what says so before the operator reads
// a stale timestamp as live.
func currentStateLabel(archived bool) string {
	if archived {
		return "Last known state"
	}
	return "Current state"
}

// historyEntry is one alert event in the per-monitor history: what
// happened and its code on the first line, the detail underneath.
templ historyEntry(ev store.AlertEventRow) {
	<div class="py-[11px] font-mono text-xs">
		<div class="flex items-baseline gap-2.5">
			@EventTypeBadge(string(ev.Type))
			if ev.StatusCode != nil && *ev.StatusCode != 0 {
				<span class="text-muted">{ fmt.Sprint(*ev.StatusCode) }</span>
			}
			<span class="ml-auto text-dim whitespace-nowrap" title={ ev.At.UTC().Format(time.RFC3339) }>{ humanDuration(ev.At) }</span>
		</div>
		<div class="text-faint mt-[3px] break-words">
			if ev.Error != nil && *ev.Error != "" {
				{ *ev.Error }
			} else if ev.DowntimeSeconds != nil {
				recovered after { humanInterval(time.Duration(*ev.DowntimeSeconds) * time.Second) }
			}
		</div>
	</div>
}

// showConfigDialog wires the header's "Show config" button to the
// pre-rendered <dialog>. Kept out of the button markup so the page has
// no inline onclick handler.
script showConfigDialog() {
	(function () {
		var d = document.getElementById('monitor-config-dialog');
		if (!d) return;
		document.querySelectorAll('[data-config-open]').forEach(function (btn) {
			btn.addEventListener('click', function () { d.showModal(); });
		});
	})();
}

// configDialog renders the effective scheduler.Plan for `m` inside a
// native <dialog>. The detail page pre-renders it (hidden) and the
// "Show config" button calls showModal(); Escape and a backdrop click
// both close it.
templ configDialog(m store.MonitorRow, cfg MonitorConfig, discoveredFrom *DiscoveredFrom) {
	@Modal("monitor-config-dialog", "Effective config · "+m.Slug) {
		<div class="max-h-[70vh] overflow-y-auto">
			@List("", false) {
				@kvWide("slug", m.Slug)
				@kvURL("url", m.URL, kvWideKeyWidth)
				@kvWide("source", string(m.Source))
				if discoveredFrom != nil {
					@kvDiscoveredFrom("discovered from", *discoveredFrom)
				}
				if len(m.Tags) > 0 {
					@kvTags("tags", m.Tags, kvWideKeyWidth)
				}
				if cfg.Preset != "" {
					@kvWide("preset", cfg.Preset)
				}
				if len(m.DependsOn) > 0 {
					@kvSlugLinks("depends on", m.DependsOn, kvWideKeyWidth)
				}
				if cfg.HTTPMethod != "" {
					@kvWide("method", cfg.HTTPMethod)
				}
				if len(cfg.AcceptedStatusCodes) > 0 {
					@kvHTTPCodes("accepted codes", cfg.AcceptedStatusCodes)
				}
				if cfg.Interval > 0 {
					@kvWide("interval", humanInterval(cfg.Interval))
				}
				if cfg.Timeout > 0 {
					@kvWide("timeout", humanInterval(cfg.Timeout))
				}
				@kvWide("retries", strconv.Itoa(cfg.Retries))
				if cfg.RetryBackoff > 0 {
					@kvWide("retry backoff", humanInterval(cfg.RetryBackoff))
				}
				@kvWide("follow redirects", boolYesNo(cfg.FollowRedirects))
				if cfg.IsHTTPS {
					@kvWide("tls insecure skip verify", boolYesNo(cfg.TLSInsecureSkipVerify))
				}
				if cfg.Proxy != "" {
					@kvWide("proxy", cfg.Proxy)
				}
				if cfg.ReminderInterval > 0 {
					@kvWide("reminder interval", humanInterval(cfg.ReminderInterval))
				}
				if cfg.SlackChannelSlug != "" {
					@kvWide("slack channel", cfg.SlackChannelSlug)
				}
				if len(cfg.Mentions) > 0 {
					@kvMentions("mentions", cfg.Mentions)
				}
				if cfg.IsHTTPS && cfg.SSLAlertThreshold > 0 {
					@kvWide("ssl alert threshold", humanInterval(cfg.SSLAlertThreshold))
				}
				if cfg.IsHTTPS && cfg.SSLEscalationThreshold > 0 {
					@kvWide("ssl escalation threshold", humanInterval(cfg.SSLEscalationThreshold))
				}
				if cfg.IsHTTPS && cfg.SSLReminderInterval > 0 {
					@kvWide("ssl reminder interval", humanInterval(cfg.SSLReminderInterval))
				}
				if cfg.UserAgent != "" {
					@kvWide("user agent", cfg.UserAgent)
				}
			}
		</div>
		<div class="pt-3.5 flex justify-end">
			<form method="dialog">
				@Button("secondary", "submit") {
					Close
				}
			</form>
		</div>
	}
	@dismissOnBackdrop()
}

// dismissOnBackdrop closes the config dialog when the click lands
// outside its panel. <dialog> already handles Escape.
script dismissOnBackdrop() {
	(function () {
		var d = document.getElementById('monitor-config-dialog');
		if (!d) return;
		d.addEventListener('click', function (e) {
			if (e.target === d) d.close();
		});
	})();
}
