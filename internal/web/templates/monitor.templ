package templates

import (
	"fmt"
	"strconv"
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// MonitorConfig is the display-side mirror of scheduler.Plan — every
// field the operator wants to see for a monitor that isn't part of
// the runtime "current state" panel. Lifecycle constructs one of these
// per-monitor by reading the live PlanSource so static + kube monitors
// render identically.
type MonitorConfig struct {
	Preset                 string
	HTTPMethod             string
	AcceptedStatusCodes    []int
	Interval               time.Duration
	Timeout                time.Duration
	Retries                int
	RetryBackoff           time.Duration
	FollowRedirects        bool
	TLSInsecureSkipVerify  bool
	Proxy                  string
	UserAgent              string
	ReminderInterval       time.Duration
	SlackChannelSlug       string
	Mentions               []MentionDisplay
	IsHTTPS                bool
	SSLAlertThreshold      time.Duration
	SSLEscalationThreshold time.Duration
	SSLReminderInterval    time.Duration
}

// MentionDisplay carries enough about a resolved Slack mention to
// render it as "<slug> <code>U…</code>" in the config dialog. For
// raw special markers (<!here>, <!channel>) the slug and ID are
// empty and Raw carries the verbatim marker.
type MentionDisplay struct {
	Slug string // reverse-resolved from userMapping; empty if unknown
	ID   string // U… for users, S… for subteams; empty for raw markers
	Raw  string // <!here>, <!channel>, etc.; empty for slug-backed mentions
}

templ kv(label, value string) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm text-slate-900 dark:text-slate-100 col-span-2 break-words">{ value }</dd>
	</div>
}

// kvTime is the same row shape as kv but the value is an
// RFC3339 + (Xago) Timestamp instead of a plain string.
templ kvTime(label string, t time.Time) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm text-slate-900 dark:text-slate-100 col-span-2">@Timestamp(t)</dd>
	</div>
}

// kvHTTPCode is the same row shape as kv but renders an HTTP status
// code as a colored chip.
templ kvHTTPCode(label string, code int) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm col-span-2">@HTTPStatusBadge(code)</dd>
	</div>
}

// kvHTTPCodes is the multi-code variant of kvHTTPCode: each accepted
// status code renders as its own colored chip so the dialog matches
// the "Last status code" treatment on the detail page.
templ kvHTTPCodes(label string, codes []int) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm col-span-2 flex flex-wrap gap-1.5">
			for _, c := range codes {
				@HTTPStatusBadge(c)
			}
		</dd>
	</div>
}

// kvTags renders the monitor's tag set as a flex-wrap of mono chips.
// Empty list renders nothing — callers wrap in if len(m.Tags) > 0.
templ kvTags(label string, tags []string) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm col-span-2 flex flex-wrap gap-1.5">
			for _, t := range tags {
				@TagChip(t)
			}
		</dd>
	</div>
}

// AppearsOnEntry is one chip in the monitor detail page's "Appears
// on" section: a label + slug + URL to the status page the monitor
// matched. Computed by the web layer by evaluating each status page's
// match tree against the monitor's tag set + host.
type AppearsOnEntry struct {
	FriendlyName string
	Slug         string
	Color        string // hex, empty for no accent
}

// kvAppearsOn renders the "Appears on" backlink list — a row of chips
// linking to /status/<slug>, capped at 5 with "+N more" overflow. See
// ADR-0003 §"Web layer / Monitor detail".
templ kvAppearsOn(label string, entries []AppearsOnEntry) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm col-span-2 flex flex-wrap items-center gap-1.5">
			{{ shown := entries }}
			{{ overflow := 0 }}
			if len(entries) > 5 {
				{{ shown = entries[:5] }}
				{{ overflow = len(entries) - 5 }}
			}
			for _, e := range shown {
				<a class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800" href={ templ.URL("/status/" + e.Slug) }>
					if e.Color != "" {
						<span class="inline-block w-2 h-2 rounded-full shrink-0" style={ "background-color: " + e.Color }></span>
					}
					<span>{ e.FriendlyName }</span>
					<code class="font-mono text-xs px-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">{ e.Slug }</code>
				</a>
			}
			if overflow > 0 {
				<span class="text-xs text-slate-500 dark:text-slate-400">+{ fmt.Sprint(overflow) } more</span>
			}
		</dd>
	</div>
}

// kvSlugLinks renders a list of monitor slugs as comma-separated
// links to each monitor's detail page. Used by "Depends on" and the
// gating-parents row so the operator can hop straight to the upstream
// monitor that's pausing or being depended on.
templ kvSlugLinks(label string, slugs []string) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm text-slate-900 dark:text-slate-100 col-span-2 break-words">
			for i, s := range slugs {
				if i > 0 {
					<span>, </span>
				}
				<a class="text-blue-700 dark:text-blue-400 hover:underline" href={ templ.URL("/monitor/" + s) }>{ s }</a>
			}
		</dd>
	</div>
}

// kvMentions renders each mention as "<slug> <code>U…</code>" so the
// operator can map a Slack ID back to the configured slug without
// hunting through userMapping. Raw markers (<!here>, <!channel>)
// render as a plain code chip — no slug to show.
templ kvMentions(label string, mentions []MentionDisplay) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm col-span-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
			for _, m := range mentions {
				<span class="inline-flex items-center gap-1.5">
					if m.Raw != "" {
						<code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-xs font-mono">{ m.Raw }</code>
					} else {
						if m.Slug != "" {
							<span>{ m.Slug }</span>
						}
						<code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-xs font-mono">{ m.ID }</code>
					}
				</span>
			}
		</dd>
	</div>
}

// kvSSL renders the SSL status as a colored chip.
templ kvSSL(label, status string) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm col-span-2">@SSLBadge(status)</dd>
	</div>
}

// kvURL renders the value as a clickable external link, opening in a
// new tab so the operator's monitor-detail tab stays put.
templ kvURL(label, href string) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm col-span-2 break-all"><a class="text-blue-700 dark:text-blue-400 hover:underline" href={ templ.URL(href) } target="_blank" rel="noopener noreferrer">{ href }</a></dd>
	</div>
}

// archivedBanner is the amber warning rendered between the title row
// and the "Last known state" card on the detail page for soft-deleted
// monitors. The reason line is omitted when archive_reason is nil or
// empty so legacy rows don't display a "Reason: " stub.
templ archivedBanner(m store.MonitorRow) {
	<div class="rounded border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-200 p-4 mb-6">
		<p class="font-semibold mb-1">This monitor has been archived.</p>
		if m.ArchiveReason != nil && *m.ArchiveReason != "" {
			<p class="text-sm mb-1">
				Reason: { *m.ArchiveReason }
				if m.ArchivedAt != nil {
					<span> — </span>
					@Timestamp(*m.ArchivedAt)
				}
			</p>
		} else if m.ArchivedAt != nil {
			<p class="text-sm mb-1">
				<span>Archived </span>
				@Timestamp(*m.ArchivedAt)
			</p>
		}
		<p class="text-sm">The state below reflects its last known values and is no longer updating.</p>
	</div>
}

// DiscoveredFrom is the (namespace, ingress, host) triple a kube-
// source monitor was materialized from. The monitor detail page
// renders a backlink to /discovery/{ns}/{name}/{host} where the
// cascade trace explains how the monitor's settings were derived.
// nil for static monitors (and for kube monitors whose snapshot row
// has been pruned).
type DiscoveredFrom struct {
	Namespace   string
	IngressName string
	Host        string
}

templ kvDiscoveredFrom(label string, d DiscoveredFrom) {
	<div class="py-1.5 grid grid-cols-3 gap-3 border-b border-slate-100 dark:border-slate-800 last:border-0">
		<dt class="text-sm text-slate-500 dark:text-slate-400">{ label }</dt>
		<dd class="text-sm col-span-2 break-words">
			<a class="text-blue-700 dark:text-blue-400 hover:underline font-mono" href={ templ.URL("/discovery/" + d.Namespace + "/" + d.IngressName + "/" + d.Host) }>{ d.Namespace }/{ d.IngressName } · { d.Host }</a>
		</dd>
	</div>
}

templ MonitorDetail(m store.MonitorRow, cfg *MonitorConfig, gatingParents []string, history []store.AlertEventRow, appearsOn []AppearsOnEntry, discoveredFrom *DiscoveredFrom) {
	{{ layoutTitle := m.FriendlyName }}
	if m.Archived {
		{{ layoutTitle = "[archived] " + m.FriendlyName }}
	}
	@Layout(layoutTitle) {
		<div class="flex items-center gap-3 mb-4">
			<h1 class="text-xl font-semibold inline-flex items-center gap-2">
				@MonitorName(m.FriendlyName)
			</h1>
			if m.Archived {
				@ArchivedChip()
			} else {
				@StatusBadge(string(m.Status))
			}
			if m.Kind == store.KindSMTP {
				@KindBadge(string(m.Kind))
			}
			if cfg != nil {
				<button
					type="button"
					class="ml-auto text-sm px-3 py-1 rounded border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800"
					onclick="document.getElementById('monitor-config-dialog').showModal()"
				>Show config</button>
			}
		</div>

		if m.Archived {
			@archivedBanner(m)
		}

		<section class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 p-4 mb-6">
			if m.Archived {
				<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Last known state</h2>
			} else {
				<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Current state</h2>
			}
			<dl class={ templ.KV("opacity-60", m.Archived) }>
				@kv("Slug", m.Slug)
				@kvURL("URL", m.URL)
				if m.Kind == store.KindSMTP {
					@kv("TLS", m.TLSMode)
				}
				@kv("Source", string(m.Source))
				if len(m.Tags) > 0 {
					@kvTags("Tags", m.Tags)
				}
				if len(appearsOn) > 0 {
					@kvAppearsOn("Appears on", appearsOn)
				}
				if cfg != nil && cfg.Preset != "" {
					@kv("Preset", cfg.Preset)
				}
				if len(m.DependsOn) > 0 {
					@kvSlugLinks("Depends on", m.DependsOn)
				}
				if string(m.Status) == "temporary-paused" && len(gatingParents) > 0 {
					@kvSlugLinks("Gated by (currently down)", gatingParents)
				}
				if m.LastCheckedAt != nil {
					@kvTime("Last checked", *m.LastCheckedAt)
				}
				if m.LastStatusCode != nil {
					@kvHTTPCode("Last status code", *m.LastStatusCode)
				}
				if m.LastError != nil && *m.LastError != "" {
					@kv("Last error", *m.LastError)
				}
				if m.OpenedAt != nil {
					@kvTime("Opened at", *m.OpenedAt)
				}
				if m.SSLStatus != nil {
					@kvSSL("SSL status", string(*m.SSLStatus))
				}
				if m.SSLExpiresAt != nil {
					@kvTime("SSL expires at", *m.SSLExpiresAt)
				}
				if m.SSLIssuer != nil && *m.SSLIssuer != "" {
					@kv("SSL issuer", *m.SSLIssuer)
				}
			</dl>
		</section>

		if cfg != nil {
			@configDialog(m, *cfg, discoveredFrom)
		}

		<section>
			<h2 class="text-sm uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Alert history</h2>
			if len(history) == 0 {
				<p class="text-sm text-slate-500 dark:text-slate-400">No alert history yet.</p>
			} else {
				<ul class="bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 divide-y divide-slate-100 dark:divide-slate-800">
					for _, ev := range history {
						<li class="py-2 px-3 text-sm flex flex-wrap items-center gap-3">
							<span class="w-20">@EventTypeBadge(string(ev.Type))</span>
							<span class="text-slate-500 dark:text-slate-400">@Timestamp(ev.At)</span>
							if ev.StatusCode != nil {
								@HTTPStatusBadge(*ev.StatusCode)
							}
							if ev.Error != nil && *ev.Error != "" {
								<span class="text-rose-700 dark:text-rose-400">{ *ev.Error }</span>
							}
							if ev.DowntimeSeconds != nil {
								<span class="text-slate-500 dark:text-slate-400">downtime { fmt.Sprint(*ev.DowntimeSeconds) }s</span>
							}
						</li>
					}
				</ul>
			}
		</section>
	}
}

// configDialog renders the effective scheduler.Plan for `m` inside a
// native <dialog>. The detail page pre-renders it (hidden) and the
// "Show config" button calls showModal(). ESC + backdrop-click close
// the dialog via the small inline JS handler at the bottom.
templ configDialog(m store.MonitorRow, cfg MonitorConfig, discoveredFrom *DiscoveredFrom) {
	<dialog
		id="monitor-config-dialog"
		class="w-[calc(100%-2rem)] max-w-4xl rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 shadow-2xl backdrop:bg-slate-900/60 p-0"
	>
		<form method="dialog" class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-6 py-4 rounded-t-xl">
			<h2 class="text-sm uppercase tracking-wide font-semibold text-slate-500 dark:text-slate-400">Effective configuration</h2>
			<button class="text-sm px-3 py-1.5 rounded border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" aria-label="Close">Close</button>
		</form>
		<div class="px-6 py-5 max-h-[70vh] overflow-y-auto">
			<dl class="[&>div]:py-2.5">
				@kv("Slug", m.Slug)
				@kvURL("URL", m.URL)
				@kv("Source", string(m.Source))
				if discoveredFrom != nil {
					@kvDiscoveredFrom("Discovered from", *discoveredFrom)
				}
				if len(m.Tags) > 0 {
					@kvTags("Tags", m.Tags)
				}
				if cfg.Preset != "" {
					@kv("Preset", cfg.Preset)
				}
				if len(m.DependsOn) > 0 {
					@kvSlugLinks("Depends on", m.DependsOn)
				}
				if cfg.HTTPMethod != "" {
					@kv("HTTP method", cfg.HTTPMethod)
				}
				if len(cfg.AcceptedStatusCodes) > 0 {
					@kvHTTPCodes("Accepted status codes", cfg.AcceptedStatusCodes)
				}
				if cfg.Interval > 0 {
					@kv("Interval", humanInterval(cfg.Interval))
				}
				if cfg.Timeout > 0 {
					@kv("Timeout", humanInterval(cfg.Timeout))
				}
				@kv("Retries", strconv.Itoa(cfg.Retries))
				if cfg.RetryBackoff > 0 {
					@kv("Retry backoff", humanInterval(cfg.RetryBackoff))
				}
				@kv("Follow redirects", boolYesNo(cfg.FollowRedirects))
				if cfg.IsHTTPS {
					@kv("TLS insecure skip verify", boolYesNo(cfg.TLSInsecureSkipVerify))
				}
				if cfg.Proxy != "" {
					@kv("Proxy", cfg.Proxy)
				}
				if cfg.ReminderInterval > 0 {
					@kv("Reminder interval", humanInterval(cfg.ReminderInterval))
				}
				if cfg.SlackChannelSlug != "" {
					@kv("Slack channel", cfg.SlackChannelSlug)
				}
				if len(cfg.Mentions) > 0 {
					@kvMentions("Mentions", cfg.Mentions)
				}
				if cfg.IsHTTPS && cfg.SSLAlertThreshold > 0 {
					@kv("SSL alert threshold", humanInterval(cfg.SSLAlertThreshold))
				}
				if cfg.IsHTTPS && cfg.SSLEscalationThreshold > 0 {
					@kv("SSL escalation threshold", humanInterval(cfg.SSLEscalationThreshold))
				}
				if cfg.IsHTTPS && cfg.SSLReminderInterval > 0 {
					@kv("SSL reminder interval", humanInterval(cfg.SSLReminderInterval))
				}
				if cfg.UserAgent != "" {
					@kv("User agent", cfg.UserAgent)
				}
			</dl>
		</div>
		<script>
			(function () {
				var d = document.getElementById('monitor-config-dialog');
				if (!d) return;
				d.addEventListener('click', function (e) {
					var r = d.getBoundingClientRect();
					var inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
					if (!inside) d.close();
				});
			})();
		</script>
	</dialog>
}
