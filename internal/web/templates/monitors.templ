package templates

import (
	"fmt"
	"net/url"
	"time"

	"github.com/toggle-corp/toggle-monitor/internal/store"
)

// MonitorsFilter is the slim shape the listing handler passes to the
// template for repopulating the filter form + reflecting the active
// sort column / direction on the table headers.
type MonitorsFilter struct {
	Search   string
	Status   string
	SSL      string
	Page     string // statusPages[].slug; "" → no page filter
	Section  int    // 0-indexed section within Page; -1 → no section filter
	Sort     string // one of store.ListSortKeys; "" → default
	SortDesc bool
	// Archived selects the archived subset: "" or "active" (default,
	// non-archived only), "archived" (archived only), or "any" (both).
	Archived string
	// Tags is the AND set of tags the listing is restricted to. Empty
	// → no tag predicate. Survives the URL round-trip as repeated
	// ?tag=foo&tag=bar query params.
	Tags []string
}

// hasTag reports whether `t` is in f.Tags. Used by the tag-picker
// checkboxes to repaint the user's selection on render.
func (f MonitorsFilter) hasTag(t string) bool {
	for _, x := range f.Tags {
		if x == t {
			return true
		}
	}
	return false
}

// tagPickerLabel renders the picker button caption: "Add tags…" when
// no tag is selected, "N selected" when one or more are. Pre-rendered
// server-side so the no-JS path shows the correct count.
func tagPickerLabel(n int) string {
	if n == 0 {
		return "Add tags…"
	}
	return fmt.Sprintf("%d selected", n)
}

// ariaSortFor reports the aria-sort value for a sortable column:
// "ascending"/"descending" on the active column, "" on the others.
func ariaSortFor(key string, f MonitorsFilter) string {
	if f.Sort != key {
		return ""
	}
	if f.SortDesc {
		return "descending"
	}
	return "ascending"
}

// filterIsActive reports whether the listing is showing anything other
// than the unfiltered default, which is what gates the "clear" action.
func (f MonitorsFilter) filterIsActive() bool {
	return f.Search != "" || f.Status != "" || f.SSL != "" || f.Page != "" ||
		len(f.Tags) > 0 || (f.Archived != "" && f.Archived != "active")
}

// tagFilter wires the popover-based tag picker on /monitors. The
// underlying `<input type="checkbox" name="tag">` array is the source
// of truth — submission happens via the form's existing Apply button
// (repeated `?tag=foo&tag=bar` params). JS only handles popover
// open/close, in-popover search, the selected-chips preview, and the
// "Clear all tags" link. Without JS the user gets a native
// <details>-driven disclosure with the same checkboxes inside; the
// chip preview row simply stays in its server-rendered state.
script tagFilter() {
	(function() {
		document.querySelectorAll("[data-tag-filter]").forEach(function(root) {
			var details = root.querySelector("details");
			if (!details) return;
			var label = root.querySelector("[data-tag-label]");
			var search = root.querySelector("[data-tag-search]");
			var options = Array.prototype.slice.call(root.querySelectorAll("[data-tag-option]"));
			var emptyState = root.querySelector("[data-tag-empty]");
			var clearBtn = root.querySelector("[data-tag-clear]");
			var form = root.closest("form");
			var chipsRoot = form ? form.querySelector("[data-tag-chips]") : null;
			var chipTpl = form ? form.querySelector("[data-tag-chip-template]") : null;

			function checkedBoxes() {
				return Array.prototype.slice.call(root.querySelectorAll("input[name='tag']:checked"));
			}

			function refresh() {
				var checked = checkedBoxes();
				if (label) {
					label.textContent = checked.length === 0 ? "Add tags…" : checked.length + " selected";
				}
				if (chipsRoot && chipTpl) {
					chipsRoot.innerHTML = "";
					if (checked.length === 0) {
						chipsRoot.classList.add("hidden");
					} else {
						chipsRoot.classList.remove("hidden");
						checked.forEach(function(cb) {
							var node = chipTpl.content.firstElementChild.cloneNode(true);
							node.setAttribute("data-tag-chip-for", cb.value);
							var lbl = node.querySelector("[data-tag-chip-label]");
							if (lbl) lbl.textContent = cb.value;
							var rm = node.querySelector("[data-tag-chip-remove]");
							if (rm) {
								rm.setAttribute("data-tag-chip-remove", cb.value);
								rm.setAttribute("aria-label", "Remove " + cb.value);
							}
							chipsRoot.appendChild(node);
						});
					}
				}
			}

			if (search) {
				search.addEventListener("input", function() {
					var q = search.value.toLowerCase().trim();
					var anyVisible = false;
					options.forEach(function(opt) {
						var tag = (opt.getAttribute("data-tag") || "").toLowerCase();
						var match = q === "" || tag.indexOf(q) !== -1;
						opt.hidden = !match;
						if (match) anyVisible = true;
					});
					if (emptyState) emptyState.hidden = anyVisible;
				});
			}

			options.forEach(function(opt) {
				var cb = opt.querySelector("input[type='checkbox']");
				if (cb) cb.addEventListener("change", refresh);
			});

			if (clearBtn) {
				clearBtn.addEventListener("click", function() {
					var changed = false;
					options.forEach(function(opt) {
						var cb = opt.querySelector("input[type='checkbox']");
						if (cb && cb.checked) {
							cb.checked = false;
							changed = true;
						}
					});
					if (changed) refresh();
				});
			}

			if (chipsRoot) {
				chipsRoot.addEventListener("click", function(e) {
					var btn = e.target.closest("[data-tag-chip-remove]");
					if (!btn) return;
					var tag = btn.getAttribute("data-tag-chip-remove");
					if (!tag) return;
					// Match on the value property rather than building a
					// CSS selector: tag values are operator-supplied and
					// need no quoting or escaping this way.
					var boxes = Array.prototype.slice.call(root.querySelectorAll("input[name='tag']"));
					var cb = null;
					for (var i = 0; i < boxes.length; i++) {
						if (boxes[i].value === tag) { cb = boxes[i]; break; }
					}
					if (cb) {
						cb.checked = false;
						refresh();
					}
				});
			}

			document.addEventListener("click", function(e) {
				if (details.open && !details.contains(e.target)) {
					details.open = false;
				}
			});
			document.addEventListener("keydown", function(e) {
				if (e.key === "Escape" && details.open) {
					details.open = false;
				}
			});
			details.addEventListener("toggle", function() {
				if (details.open && search) {
					search.focus();
				}
			});
		});
	})();
}

// monitorsCols is the listing's shared column template. Name and URL
// take the slack; the machine-value columns are sized to their content
// so the eye can run straight down them.
const monitorsCols = "1.6fr .9fr .7fr 1.7fr .5fr .8fr .9fr .9fr"

// sortableHeader renders one header cell as a clickable link that
// toggles the sort direction when the column is already active, or
// sets a default ascending sort otherwise. The active column gets an
// ASCII ↑ / ↓ indicator plus aria-sort, so the current state is visible
// both to the eye and to a screen reader.
templ sortableHeader(label, key string, f MonitorsFilter) {
	@TableHeadCell(ariaSortFor(key, f)) {
		<a class="inline-flex items-center gap-1 hover:text-ink rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL(sortHref(key, f)) }>
			{ label }
			if f.Sort == key {
				if f.SortDesc {
					<span aria-hidden="true">↓</span>
				} else {
					<span aria-hidden="true">↑</span>
				}
			}
		</a>
	}
}

// Paginator renders prev/next controls plus a "page X of Y" indicator.
// extraParams are URL-encoded query-string entries to keep on every
// link (filters, search, etc.).
templ Paginator(basePath string, page, perPage, total int, extraParams url.Values) {
	if total <= perPage && page == 1 {
		// Nothing to paginate.
	} else {
		<nav aria-label="Pagination" class="flex items-center justify-between font-mono text-xs text-muted">
			<span>page { fmt.Sprint(page) } of { fmt.Sprint(pageCount(total, perPage)) } · { fmt.Sprint(total) } total</span>
			<span class="flex gap-2">
				if page > 1 {
					@paginatorStep(paginatorLink(basePath, extraParams, page-1), "prev")
				}
				if page*perPage < total {
					@paginatorStep(paginatorLink(basePath, extraParams, page+1), "next")
				}
			</span>
		</nav>
	}
}

templ paginatorStep(href templ.SafeURL, label string) {
	<a href={ href } class="px-3 py-1.5 border border-border rounded-md text-ink hover:bg-surface-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{ label }</a>
}

templ MonitorsPage(listing store.MonitorListing, filter MonitorsFilter, statusPages []*StatusConfig, distinctTags []string, page, perPage int) {
	@Layout("Monitors") {
		@Eyebrow(fmt.Sprintf("Monitors · %d total", listing.Total))
		<form
			hx-get="/monitors"
			hx-target="body"
			hx-push-url="true"
			method="get"
			action="/monitors"
			class="flex flex-col gap-3"
		>
			@Toolbar() {
				<div class="flex-1 min-w-[200px]">
					@SearchField("q", "search name or slug…", filter.Search)
				</div>
				@SelectField("status", "Status") {
					<option value="" selected?={ filter.Status == "" }>status: any</option>
					<option value="up" selected?={ filter.Status == "up" }>up</option>
					<option value="down" selected?={ filter.Status == "down" }>down</option>
					<option value="temporary-paused" selected?={ filter.Status == "temporary-paused" }>temporary-paused</option>
				}
				@SelectField("ssl", "SSL") {
					<option value="" selected?={ filter.SSL == "" }>ssl: any</option>
					<option value="ok" selected?={ filter.SSL == "ok" }>ok</option>
					<option value="ssl-expiring" selected?={ filter.SSL == "ssl-expiring" }>ssl-expiring</option>
					<option value="expired" selected?={ filter.SSL == "expired" }>expired</option>
					<option value="ssl-skipped" selected?={ filter.SSL == "ssl-skipped" }>ssl-skipped</option>
				}
				@SelectField("status_page", "Status page") {
					<option value="" selected?={ filter.Page == "" }>page: any</option>
					for _, p := range statusPages {
						<option value={ p.Slug } selected?={ filter.Page == p.Slug }>{ p.FriendlyName }</option>
					}
				}
				if len(distinctTags) > 0 {
					@tagPicker(filter, distinctTags)
				}
				@SelectField("archived", "Archived") {
					<option value="" selected?={ filter.Archived == "" || filter.Archived == "active" }>active</option>
					<option value="archived" selected?={ filter.Archived == "archived" }>archived</option>
					<option value="any" selected?={ filter.Archived == "any" }>any</option>
				}
				@Button("primary", "submit") {
					apply
				}
				if filter.filterIsActive() {
					@LinkButton("ghost", "/monitors") {
						clear
					}
				}
			}
			if len(distinctTags) > 0 {
				<div data-tag-chips class={ "flex flex-wrap gap-2", templ.KV("hidden", len(filter.Tags) == 0) }>
					for _, t := range filter.Tags {
						@selectedTagChip(t)
					}
				</div>
				<template data-tag-chip-template>
					@selectedTagChip("")
				</template>
			}
		</form>
		@tagFilter()
		if len(listing.Items) == 0 {
			@EmptyState("No monitors match your filters") {
				<a class="text-accent underline underline-offset-2 hover:text-accent-strong rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/monitors">clear filters</a>
			}
		} else {
			<div class="overflow-x-auto">
				@Table(monitorsCols) {
					@TableRow(true, "") {
						@sortableHeader("name", "name", filter)
						@TableHeadCell("") {
							tags
						}
						@sortableHeader("status", "status", filter)
						@sortableHeader("url", "url", filter)
						@sortableHeader("code", "code", filter)
						@sortableHeader("checked", "checked", filter)
						@TableHeadCell("") {
							depends on
						}
						@sortableHeader("ssl", "ssl_expires", filter)
					}
					for _, m := range listing.Items {
						@MonitorRow(m)
					}
				}
			</div>
			@Paginator("/monitors", page, perPage, listing.Total, paramsFromFilter(filter))
		}
	}
}

// MonitorRow is one row in the listing. The URL is a real clickable
// link (target=_blank so the operator's listing tab stays open), and
// the last error — when present — sits under the name so a glance at
// the listing is enough to triage a flood of failures. Down rows carry
// a soft wash so they stay findable in a long page.
templ MonitorRow(m store.MonitorRow) {
	{{ tone := MonitorTone(string(m.Status), m.Archived) }}
	@TableRow(false, tone) {
		@TableCell("") {
			<span class="flex flex-wrap items-center gap-2">
				<a class="text-[13px] hover:underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/monitor/" + m.Slug) }>
					@MonitorName(m.FriendlyName)
				</a>
				if m.Archived {
					@ArchivedChip()
				}
			</span>
			if m.LastError != nil && *m.LastError != "" {
				<div class="text-2xs text-down mt-[3px] break-words">{ *m.LastError }</div>
			}
		}
		@TableCell("") {
			if len(m.Tags) == 0 {
				@Dash()
			} else {
				<span class="flex flex-wrap gap-1">
					for _, t := range m.Tags {
						@TagChip(t)
					}
				</span>
			}
		}
		@TableCell("") {
			@StatusBadge(string(m.Status))
		}
		@TableCell("") {
			<a class="text-faint hover:text-accent hover:underline underline-offset-2 break-all rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL(m.URL) } target="_blank" rel="noopener noreferrer">{ m.URL }</a>
		}
		@TableCell("") {
			if m.LastStatusCode != nil && *m.LastStatusCode != 0 {
				@HTTPStatusBadge(*m.LastStatusCode)
			} else {
				@Dash()
			}
		}
		@TableCell("") {
			if m.LastCheckedAt != nil {
				<span class="text-muted whitespace-nowrap" title={ m.LastCheckedAt.UTC().Format(time.RFC3339) }>{ humanDuration(*m.LastCheckedAt) }</span>
			} else {
				@Dash()
			}
		}
		@TableCell("") {
			if len(m.DependsOn) > 0 {
				<span class="flex flex-wrap gap-x-1 gap-y-0.5 text-2xs">
					for i, dep := range m.DependsOn {
						if i > 0 {
							<span class="text-dim" aria-hidden="true">·</span>
						}
						<a class="text-muted hover:text-accent hover:underline underline-offset-2 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={ templ.URL("/monitor/" + dep) }>{ dep }</a>
					}
				</span>
			} else {
				@Dash()
			}
		}
		@TableCell("") {
			{{ var sslStatus string }}
			if m.SSLStatus != nil {
				{{ sslStatus = string(*m.SSLStatus) }}
			}
			@SSLCell(sslStatus, m.SSLExpiresAt)
		}
	}
}

// selectedTagChip is one removable chip in the tag-filter preview row.
// The same markup backs the <template> the picker's JS clones, so the
// server-rendered and client-rendered chips can't drift.
templ selectedTagChip(tag string) {
	<span data-tag-chip-for={ tag } class="inline-flex items-center gap-1 pl-2.5 pr-1 py-0.5 rounded-full border border-ink bg-ink text-bg font-mono text-2xs font-semibold">
		<span data-tag-chip-label>{ tag }</span>
		<button
			type="button"
			data-tag-chip-remove={ tag }
			if tag != "" {
				aria-label={ "Remove " + tag }
			} else {
				aria-label="Remove tag"
			}
			class="inline-flex items-center justify-center w-4 h-4 rounded-full hover:bg-ink-active leading-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent"
		>×</button>
	</span>
}

// tagPicker is the popover-backed multi-select for the AND tag filter.
// The checkboxes are the source of truth; without JS the native
// <details> disclosure still submits them through the form's apply
// button.
templ tagPicker(filter MonitorsFilter, distinctTags []string) {
	<div data-tag-filter>
		<details class="relative">
			<summary class="list-none cursor-pointer inline-flex items-center gap-2 border border-border rounded-md px-[11px] py-2 min-h-[34px] font-mono text-[12.5px] text-ink min-w-[10rem] hover:bg-surface-hover hover:border-border-strong">
				<span class="flex-1" data-tag-label>{ tagPickerLabel(len(filter.Tags)) }</span>
				<span class="text-faint flex" aria-hidden="true">
					@Icon("chevron-down", 12)
				</span>
			</summary>
			<div class="absolute z-10 mt-1 w-72 max-h-80 bg-surface border border-border rounded-lg shadow-xs flex flex-col overflow-hidden">
				<div class="p-2 border-b border-border">
					<input type="text" placeholder="Filter tags…" data-tag-search class="w-full bg-transparent border border-border rounded-md px-2 py-1 font-mono text-xs text-ink placeholder:text-dim focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent"/>
				</div>
				<div class="overflow-y-auto flex-1" data-tag-options>
					for _, t := range distinctTags {
						<label data-tag-option data-tag={ t } class="flex items-center gap-2 px-3 py-1.5 font-mono text-xs text-ink cursor-pointer hover:bg-surface-hover">
							<input type="checkbox" name="tag" value={ t } checked?={ filter.hasTag(t) } class="rounded border-border-strong accent-[--tm-accent]"/>
							<span>{ t }</span>
						</label>
					}
					<div data-tag-empty hidden class="px-3 py-2 font-mono text-xs text-faint">No matching tags</div>
				</div>
				<div class="p-2 border-t border-border flex justify-end">
					<button type="button" data-tag-clear class="font-mono text-2xs text-muted hover:text-ink rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">clear all tags</button>
				</div>
			</div>
		</details>
	</div>
}
